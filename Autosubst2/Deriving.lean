import Autosubst2.Basic
import Autosubst2.Bind
import Autosubst2.Class
import Autosubst2.AsimplAttr
import Autosubst2.Unscoped
import Lean

/-!
# Autosubst-2 derivation metaprogram (single-sort)

Generates well-scoped de Bruijn substitution infrastructure from an indexed
inductive `T : Nat → Type` whose constructors are one of:

* the VARIABLE constructor: a single `Idx n` argument (the scope param),
* otherwise: arguments that are either non-recursive or recursive subterms
  `T (n + k)` (k binders).

We emit `ren`, `up`, `subst`, `ids`, `subst0` and the σ-lemma chain, matching
`Autosubst2/Examples/Utlc.lean` exactly.

## UX choice

We expose a command macro `derive_autosubst% T` rather than a `deriving`
handler.  Deriving handlers are awkward for emitting *theorems* (they are
expected to produce instances), so a dedicated command is cleaner.  It is run
*after* the inductive is defined, in the same namespace.

## Constructor analysis

For each constructor we classify every explicit argument as
* `.var`   — an `Idx <scope>` argument (marks the variable constructor),
* `.rec k` — a recursive `T (<scope> + k)` argument under `k` binders,
* `.other` — anything else (a payload kept verbatim, e.g. `Int`/`Nat`/`BinOp`;
  never traversed by `ren`/`subst`).
-/

open Lean Elab Command Meta Lean.Parser.Term

namespace Autosubst2.Deriving

/-- Trace the commands generated by `derive_autosubst%`. Enable with
`set_option trace.derive_autosubst.gen true`. -/
initialize registerTraceClass `derive_autosubst.gen

/-- Pretty-print and trace a generated command, then elaborate it. -/
def elabGen (cmd : TSyntax `command) : CommandElabM Unit := do
  trace[derive_autosubst.gen] "{← liftCoreM <| Lean.PrettyPrinter.ppCommand cmd}"
  elabCommand cmd

/-- Classification of a constructor argument.  `.other` carries the payload's
delaborated type so backends that regenerate the inductive (the unscoped one)
can reproduce it verbatim. -/
inductive ArgKind where
  | var
  | recBinders (k : Nat)
  | other (ty : Term)
  deriving Inhabited

/-- A constructor's analysed shape: its name and the kinds of its explicit args. -/
structure CtorInfo where
  name : Name
  args : Array ArgKind

/-- Is this the variable constructor? -/
def CtorInfo.isVar (c : CtorInfo) : Bool := c.args.any fun | .var => true | _ => false

/-- Syntactic offset of an index expression of the form `scope + k` / nested
`Nat.succ`, returning `k`.  Used by `analyseMulti` to read per-column binder
depth from a recursive argument's indices. -/
private partial def addOffsetOf (idx : Expr) : Nat :=
  match idx.getAppFnArgs with
  | (``HAdd.hAdd, as) =>
    if as.size == 6 then
      match as[5]!.nat? with
      | some k => k + addOffsetOf as[4]!
      | none => 0
    else 0
  | (``Nat.succ, as) => if as.size == 1 then 1 + addOffsetOf as[0]! else 0
  | _ => 0

/-- Analyse the indexed inductive `tyName : Nat → Type`, returning per-ctor info. -/
def analyse (tyName : Name) : MetaM (Array CtorInfo) := do
  let .inductInfo ind ← getConstInfo tyName
    | throwError "{tyName} is not an inductive"
  unless ind.numIndices == 1 do
    throwError "derive_autosubst% expects exactly one (scope) index on {tyName}"
  let mut result := #[]
  for ctor in ind.ctors do
    let .ctorInfo ci ← getConstInfo ctor | throwError "bad ctor {ctor}"
    let kinds ← forallTelescopeReducing ci.type fun xs _body => do
      let mut kinds := #[]
      for x in xs[ci.numParams:] do
        -- Inspect the type's head BEFORE `whnf`: the `Bind` marker is a
        -- reducible `abbrev` and would otherwise unfold to `T (n+1)`.
        let xtyRaw ← inferType x
        -- Peel nested `Autosubst2.Bind` heads; each adds one binder.  The depth
        -- `k` is the number of `Bind` wrappers around the eventual `T …`.
        let mut peeled := xtyRaw
        let mut k := 0
        while peeled.isAppOf ``Autosubst2.Bind do
          -- `Bind T n`: the wrapped (term-sort) head is the first explicit arg.
          peeled := peeled.getAppArgs[0]!
          k := k + 1
        if k > 0 then
          -- recursive subterm under `k` binders (head is/was the inductive `T`).
          kinds := kinds.push (ArgKind.recBinders k)
        else
          let xty ← whnf xtyRaw
          if xty.isConstOf ``Nat && !(← x.fvarId!.getDecl).binderInfo.isExplicit then
            -- the implicit scope binder `{n : Nat}`; not a real ctor argument.
            -- An EXPLICIT `Nat` is a payload and falls through to `.other`.
            continue
          else if xty.isAppOf ``Idx then
            kinds := kinds.push ArgKind.var
          else if xty.isAppOf tyName then
            -- recursive arg `T (scope + k)` with no `Bind` wrapper: read the
            -- binder depth `k` from the index arithmetic (0 when plain `T scope`).
            kinds := kinds.push (ArgKind.recBinders (addOffsetOf xty.getAppArgs[0]!))
          else
            kinds := kinds.push (ArgKind.other (← Lean.PrettyPrinter.delab xtyRaw))
      pure kinds
    result := result.push { name := ctor, args := kinds }
  return result

/-! ## Syntax generation -/

/-- Fresh binder names `a0, a1, ...` as identifiers. -/
private def argIdents (n : Nat) : Array Ident :=
  (Array.range n).map fun i => mkIdent (Name.mkSimple s!"a{i}")

/-- Build the `ren`/`subst` match alternatives for a constructor.
`opName` is `ren`/`subst`; `liftZero`/`liftSucc` build the lifted map applied to
a recursive arg under k binders (`up_ren`/`up`).  Returns one `matchAltExpr`. -/
private def mkOpAlt (c : CtorInfo) (op : Ident) (sigma : Ident)
    (liftN : Nat → Ident → TermElabM Term) (isSubst : Bool) :
    TermElabM (TSyntax ``Parser.Term.matchAlt) := do
  let short := mkIdent (Name.mkSimple c.name.getString!)
  let pats := argIdents c.args.size
  let dotPat ← `(.$short:ident $pats*)
  if c.isVar then
    let x := pats[0]!
    if isSubst then
      `(matchAltExpr| | $dotPat => $sigma $x)
    else
      `(matchAltExpr| | $dotPat => .$short:ident ($sigma $x))
  else
    let mut rhsArgs : Array Term := #[]
    for a in pats, kind in c.args do
      match kind with
      | .recBinders k =>
        let lifted ← liftN k sigma
        rhsArgs := rhsArgs.push (← `($op $lifted $a))
      | _ => rhsArgs := rhsArgs.push a
    `(matchAltExpr| | $dotPat => .$short:ident $rhsArgs*)

/-- Generate the operation definitions for single-sort inductive `tyName`. -/
def genOps (tyName : Name) (ctors : Array CtorInfo) : CommandElabM (Array (TSyntax `command)) := do
  let tyId := mkIdent tyName
  -- Use non-hygienic global names so the generated lemmas can refer to them.
  let renI := mkIdent `ren
  let upI := mkIdent `up
  let substI := mkIdent `subst
  let idsI := mkIdent `ids
  let subst0I := mkIdent `subst0
  let varI := mkIdent (tyName ++ `var)
  liftTermElabM do
    let sigma := mkIdent `sigma
    let xi := mkIdent `xi
    -- ren
    let renAlts ← ctors.mapM fun c =>
      mkOpAlt c renI xi (fun k base => do
        -- apply up_ren k times
        let mut t : Term := base
        for _ in [0:k] do t ← `(up_ren $t)
        pure t) false
    let renDef ← `(command|
      def $renI {m n : Nat} ($xi : Idx m → Idx n) : $tyId m → $tyId n
        $renAlts:matchAlt*)
    -- up
    let mI := mkIdent `m
    let nI := mkIdent `n
    let upDef ← `(command|
      def $upI {$mI $nI : Nat} ($sigma : Idx $mI → $tyId $nI) : Idx ($mI + 1) → $tyId ($nI + 1) :=
        ($varI var_zero) .: (fun x => $renI shift ($sigma x)))
    -- subst
    let substAlts ← ctors.mapM fun c =>
      mkOpAlt c substI sigma (fun k base => do
        let mut t : Term := base
        for _ in [0:k] do t ← `($upI $t)
        pure t) true
    let substDef ← `(command|
      def $substI {m n : Nat} ($sigma : Idx m → $tyId n) : $tyId m → $tyId n
        $substAlts:matchAlt*)
    -- ids
    let idsDef ← `(command|
      def $idsI {n : Nat} : Idx n → $tyId n := $varI)
    -- subst0
    let subst0Def ← `(command|
      def $subst0I {n : Nat} (e : $tyId (n + 1)) (u : $tyId n) : $tyId n :=
        $substI (u .: $idsI) e)
    -- `Subst` instance: fields point at the generated bare ops.
    let instDef ← `(command|
      instance : Autosubst2.Subst $tyId where
        vr    := $varI
        ren   := $renI
        subst := $substI)
    pure #[renDef, upDef, substDef, idsDef, subst0Def, instDef]

/-! ## Lemma generation -/

/-- The variable-ctor short name (e.g. `var`). -/
private def varCtorShort (ctors : Array CtorInfo) : Name :=
  match ctors.find? CtorInfo.isVar with
  | some c => Name.mkSimple c.name.getString!
  | none => `var

/-- Non-variable ctors split into "leaf-recursive" (recursive, no extra binder,
i.e. all k=0, e.g. `app`) and "binder" (some k>0, e.g. `lam`). -/
private def isBinderCtor (c : CtorInfo) : Bool :=
  c.args.any fun | .recBinders k => k > 0 | _ => false

/-- Distinct positive binder depths of a ctor's recursive args, ascending. -/
private def binderDepths (c : CtorInfo) : Array Nat :=
  ((c.args.filterMap fun
      | .recBinders k => if k > 0 then some k else none
      | _ => none).toList.eraseDups.toArray).qsort (· < ·)

/-- Build the binder-case up-commutation tactic block for the distinct binder
depths `depths` (ascending, all > 0) occurring in one constructor: one
`have h<j> : (fun x => f<j> (g<j> x)) = rhs<j>` per depth `j ∈ [1, max depths]`
(each proved by `funext x` and the pointwise `step` at lift level `j - 1`,
rewriting with `h<j-1>` for `j > 1`), then a final `rw` with the haves whose
depths actually occur.  `fT`/`gT`/`rhsT` build the two composed lifted maps and
the RHS map at depth `j`; `step j` is the pointwise commutation equation at
lift level `j`, applied to the `funext` variable `x`. -/
private def mkUpChainTac (depths : Array Nat)
    (fT gT rhsT step : Nat → TermElabM Term) : TermElabM (TSyntax `tactic) := do
  let maxD := depths.foldl max 0
  let hId (j : Nat) : Ident := mkIdent (Name.mkSimple s!"h{j}")
  let mut tacs : Array (TSyntax `tactic) := #[]
  for i in [0:maxD] do
    let j := i + 1
    let lhs ← `(fun x => $(← fT j) ($(← gT j) x))
    let rhs ← rhsT j
    let st ← step (j - 1)
    let tac ←
      if j == 1 then
        `(tactic| have $(hId j):ident : $lhs = $rhs := by funext x; rw [$st:term])
      else
        `(tactic| have $(hId j):ident : $lhs = $rhs := by funext x; rw [$st:term, $(hId (j-1)):ident])
    tacs := tacs.push tac
  let rws ← depths.mapM fun d => `(Lean.Parser.Tactic.rwRule| $(hId d):ident)
  tacs := tacs.push (← `(tactic| rw [$[$rws],*]))
  let mut result := tacs[0]!
  for t in tacs[1:] do
    result ← `(tactic| ($result; $t))
  pure result

/-- Build the inductive-proof match alts for a uniform σ-lemma of the form
`∀ t, LHS = RHS` proved by induction on `t`.  Per ctor:
* var ctor  → `rfl`
* app-like  → `by simp only [<defs>]; rw [<IH>, <IH>, ...]`  (IH = `lemmaId`)
* lam-like  → `by simp only [<defs>]; rw [<IH>]; <binderTac>`
`lemmaId` is the lemma's OWN name (self-reference is the induction hypothesis).
`binderTac` is the up-commutation block (an `mkUpChainTac` chain), computed
from the ctor's distinct positive binder depths. -/
private def mkIndAlts (ctors : Array CtorInfo) (lemmaId : Ident)
    (defSimp : Array Ident) (binderTac : Array Nat → TermElabM (TSyntax `tactic))
    : TermElabM (Array (TSyntax ``Parser.Term.matchAlt)) := do
  ctors.mapM fun c => do
    let short := mkIdent (Name.mkSimple c.name.getString!)
    let pats := argIdents c.args.size
    let dotPat ← `(.$short:ident $pats*)
    if c.isVar then
      `(matchAltExpr| | $dotPat => rfl)
    else
      let recCount := c.args.foldl (fun acc k => match k with | .recBinders _ => acc+1 | _ => acc) 0
      let rws ← (Array.range recCount).mapM (fun _ => `(Lean.Parser.Tactic.rwRule| $lemmaId:ident))
      if isBinderCtor c then
        let upTac ← binderTac (binderDepths c)
        `(matchAltExpr| | $dotPat => by
            simp only [$[$defSimp:ident],*]
            rw [$[$rws],*]
            $upTac:tactic)
      else if rws.isEmpty then
        -- payload-only ctor (all args `.other`): the defs close the goal.
        `(matchAltExpr| | $dotPat => by simp only [$[$defSimp:ident],*])
      else
        `(matchAltExpr| | $dotPat => by simp only [$[$defSimp:ident],*]; rw [$[$rws],*])

/-- Generate the full σ-lemma chain.  Statements and proof scaffolding are fixed
for the single-sort case; we thread the inductive's name, variable-ctor short
name, and ctor info.  The "up-commutation helper" lemmas (`up_up_ren`,
`up_ren_subst`, `up_subst`, `up_ids`) are emitted with `cases x` proofs. -/
def genLemmas (tyName : Name) (ctors : Array CtorInfo) :
    CommandElabM (Array (TSyntax `command)) := do
  let tyId := mkIdent tyName
  let renI := mkIdent `ren
  let substI := mkIdent `subst
  let upI := mkIdent `up
  let idsI := mkIdent `ids
  let subst0I := mkIdent `subst0
  -- lemma names, all global (non-hygienic) so cross-references resolve.
  let renRenN := mkIdent `ren_ren
  let upUpRenN := mkIdent `up_up_ren
  let substRenN := mkIdent `subst_ren
  let upRenSubstN := mkIdent `up_ren_subst
  let renSubstN := mkIdent `ren_subst
  let upSubstN := mkIdent `up_subst
  let substSubstN := mkIdent `subst_subst
  let upIdsN := mkIdent `up_ids
  let substIdN := mkIdent `subst_id
  let renEqSubstN := mkIdent `ren_eq_subst
  let renIdN := mkIdent `ren_id
  let subst0SubstUpN := mkIdent `subst0_subst_up
  let substVarN := mkIdent `subst_var
  let renVarN := mkIdent `ren_var
  let upIdsEqN := mkIdent `up_ids_eq
  let upRenIdN := mkIdent `up_ren_id
  liftTermElabM do
    -- `up_ren^j`/`up^j` iterated lifts of a base map term.
    let upRenOf (j : Nat) (t : Term) : TermElabM Term := do
      let mut r := t
      for _ in [0:j] do r ← `(up_ren $r)
      pure r
    let upOf (j : Nat) (t : Term) : TermElabM Term := do
      let mut r := t
      for _ in [0:j] do r ← `($upI $r)
      pure r
    let renRenAlts ← mkIndAlts ctors renRenN #[renI] fun depths =>
      mkUpChainTac depths
        (fun j => do upRenOf j (← `(zeta)))
        (fun j => do upRenOf j (← `(xi)))
        (fun j => do upRenOf j (← `(fun x => zeta (xi x))))
        (fun j => do
          let xiJ ← upRenOf j (← `(xi))
          let zetaJ ← upRenOf j (← `(zeta))
          `(up_ren_ren $xiJ $zetaJ (fun y => $zetaJ ($xiJ y)) (fun _ => rfl) x))
    let renRen ← `(command|
      theorem $renRenN {m n k : Nat} (xi : Idx m → Idx n) (zeta : Idx n → Idx k) :
          ∀ t : $tyId m, $renI zeta ($renI xi t) = $renI (fun x => zeta (xi x)) t
        $renRenAlts:matchAlt*)

    let upUpRen ← `(command|
      theorem $upUpRenN {m n k : Nat} (sigma : Idx m → $tyId n) (xi : Idx k → Idx m)
          (x : Idx (k + 1)) :
          $upI sigma (up_ren xi x) = $upI (fun y => sigma (xi y)) x := by
        cases x <;> simp [$upI:ident, up_ren, scons, shift, var_zero])

    let substRenAlts ← mkIndAlts ctors substRenN #[renI, substI] fun depths =>
      mkUpChainTac depths
        (fun j => do upOf j (← `(sigma)))
        (fun j => do upRenOf j (← `(xi)))
        (fun j => do upOf j (← `(fun x => sigma (xi x))))
        (fun j => do
          let sJ ← upOf j (← `(sigma))
          let xiJ ← upRenOf j (← `(xi))
          `($upUpRenN $sJ $xiJ x))
    let substRen ← `(command|
      theorem $substRenN {m n k : Nat} (sigma : Idx n → $tyId k) (xi : Idx m → Idx n) :
          ∀ t : $tyId m, $substI sigma ($renI xi t) = $substI (fun x => sigma (xi x)) t
        $substRenAlts:matchAlt*)

    let upRenSubst ← `(command|
      theorem $upRenSubstN {m n k : Nat} (xi : Idx n → Idx k) (sigma : Idx m → $tyId n)
          (x : Idx (m + 1)) :
          $upI (fun y => $renI xi (sigma y)) x = $renI (up_ren xi) ($upI sigma x) := by
        cases x with
        | none => rfl
        | some y =>
          simp only [$upI:ident, scons, shift]
          rw [$renRenN:term, $renRenN:term]
          rfl)

    let renSubstAlts ← mkIndAlts ctors renSubstN #[substI, renI] fun depths =>
      mkUpChainTac depths
        (fun j => do `($renI $(← upRenOf j (← `(xi)))))
        (fun j => do upOf j (← `(sigma)))
        (fun j => do upOf j (← `(fun x => $renI xi (sigma x))))
        (fun j => do
          let xiJ ← upRenOf j (← `(xi))
          let sJ ← upOf j (← `(sigma))
          `(($upRenSubstN $xiJ $sJ x).symm))
    let renSubst ← `(command|
      theorem $renSubstN {m n k : Nat} (xi : Idx n → Idx k) (sigma : Idx m → $tyId n) :
          ∀ t : $tyId m, $renI xi ($substI sigma t) = $substI (fun x => $renI xi (sigma x)) t
        $renSubstAlts:matchAlt*)

    let upSubst ← `(command|
      theorem $upSubstN {m n k : Nat} (sigma : Idx m → $tyId n) (tau : Idx n → $tyId k)
          (x : Idx (m + 1)) :
          $upI (fun y => $substI tau (sigma y)) x = $substI ($upI tau) ($upI sigma x) := by
        cases x with
        | none => rfl
        | some y =>
          simp only [$upI:ident, scons, shift]
          rw [$renSubstN:term, $substRenN:term]
          rfl)

    let substSubstAlts ← mkIndAlts ctors substSubstN #[substI] fun depths =>
      mkUpChainTac depths
        (fun j => do `($substI $(← upOf j (← `(tau)))))
        (fun j => do upOf j (← `(sigma)))
        (fun j => do upOf j (← `(fun x => $substI tau (sigma x))))
        (fun j => do
          let sJ ← upOf j (← `(sigma))
          let tauJ ← upOf j (← `(tau))
          `(($upSubstN $sJ $tauJ x).symm))
    let substSubst ← `(command|
      theorem $substSubstN {m n k : Nat} (sigma : Idx m → $tyId n) (tau : Idx n → $tyId k) :
          ∀ t : $tyId m, $substI tau ($substI sigma t) = $substI (fun x => $substI tau (sigma x)) t
        $substSubstAlts:matchAlt*)

    let upIds ← `(command|
      theorem $upIdsN {n : Nat} (x : Idx (n + 1)) : $upI $idsI x = $idsI x := by
        cases x <;> rfl)

    -- Function-level identity lemmas: as `simp only` rules they collapse
    -- `up (… (up ids))` / `up_ren (… (up_ren id))` at ANY binder depth.
    let upIdsEq ← `(command|
      theorem $upIdsEqN {n : Nat} : $upI ($idsI : Idx n → $tyId n) = $idsI := by
        funext x; exact $upIdsN x)
    let upRenId ← `(command|
      theorem $upRenIdN {n : Nat} : up_ren (id : Idx n → Idx n) = id := by
        funext x; cases x <;> rfl)

    -- subst_id has an extra `{n}` pattern column; build a bespoke version.
    let substIdAlts2 ← ctors.mapM fun c => do
      let short := mkIdent (Name.mkSimple c.name.getString!)
      let pats := argIdents c.args.size
      let dotPat ← `(.$short:ident $pats*)
      if c.isVar then
        `(matchAltExpr| | _, $dotPat => rfl)
      else
        let recCount := c.args.foldl (fun acc k => match k with | .recBinders _ => acc+1 | _ => acc) 0
        if recCount == 0 then
          `(matchAltExpr| | _, $dotPat => by simp only [$substI:ident])
        else
          let rws ← (Array.range recCount).mapM (fun _ => `(Lean.Parser.Tactic.rwRule| $substIdN:ident))
          `(matchAltExpr| | _, $dotPat => by
              simp only [$substI:ident, $upIdsEqN:ident]; rw [$[$rws],*])
    let substId ← `(command|
      theorem $substIdN : ∀ {n : Nat} (t : $tyId n), $substI $idsI t = t
        $substIdAlts2:matchAlt*)

    -- ren_eq_subst (extra `{n}` column; lifts collapse via the `_eq`/`_id` rules)
    let renEqAlts ← ctors.mapM fun c => do
      let short := mkIdent (Name.mkSimple c.name.getString!)
      let pats := argIdents c.args.size
      let dotPat ← `(.$short:ident $pats*)
      if c.isVar then
        `(matchAltExpr| | _, $dotPat => rfl)
      else
        let recCount := c.args.foldl (fun acc k => match k with | .recBinders _ => acc+1 | _ => acc) 0
        if recCount == 0 then
          `(matchAltExpr| | _, $dotPat => by simp only [$renI:ident, $substI:ident])
        else
          let rws ← (Array.range recCount).mapM (fun _ => `(Lean.Parser.Tactic.rwRule| $renEqSubstN:ident))
          `(matchAltExpr| | _, $dotPat => by
              simp only [$renI:ident, $substI:ident, $upRenIdN:ident, $upIdsEqN:ident]
              rw [$[$rws],*])
    let renEqSubst ← `(command|
      theorem $renEqSubstN : ∀ {n : Nat} (t : $tyId n), $renI id t = $substI $idsI t
        $renEqAlts:matchAlt*)

    let renId ← `(command|
      theorem $renIdN {n : Nat} (t : $tyId n) : $renI id t = t := by
        rw [$renEqSubstN:term, $substIdN:term])

    let subst0SubstUp ← `(command|
      theorem $subst0SubstUpN {m n : Nat} (sigma : Idx m → $tyId n) (e : $tyId (m + 1))
          (u : $tyId n) :
          $subst0I ($substI ($upI sigma) e) u = $substI (u .: sigma) e := by
        unfold $subst0I
        rw [$substSubstN:term]
        congr 1
        funext x
        cases x with
        | none => rfl
        | some y =>
          simp only [$upI:ident, scons, shift]
          rw [$substRenN:term]
          have h : (fun z => (u .: $idsI) (some z)) = $idsI := by funext z; rfl
          rw [h, $substIdN:term])

    -- Variable-computation lemmas: `subst σ (var x) = σ x`, `ren ξ (var x) = var (ξ x)`.
    -- Safe (`rfl`) and only fire on variable nodes, so they don't loop with the
    -- composition rules; they let the generic `asimpl` compute `subst`/`ren` on a
    -- concrete variable after a case split, without naming the bare op.
    let varI := mkIdent (tyName ++ `var)
    let substVar ← `(command|
      theorem $substVarN {m n : Nat} (sigma : Idx m → $tyId n) (x : Idx m) :
          $substI sigma ($varI x) = sigma x := rfl)
    let renVar ← `(command|
      theorem $renVarN {m n : Nat} (xi : Idx m → Idx n) (x : Idx m) :
          $renI xi ($varI x) = $varI (xi x) := rfl)
    -- Pointwise computation rules for `up`.  Tagging the `up` *definition*
    -- itself would make `simp only [autosubst]` unfold `up σ` to its `scons`
    -- form even when unapplied, stranding `scons` applications that the core
    -- set cannot reduce; these applied-form rules compute `up` on a concrete
    -- index while leaving `up σ` folded elsewhere.
    let upZeroN := mkIdent `up_zero
    let upNoneN := mkIdent `up_none
    let upSomeN := mkIdent `up_some
    let upZero ← `(command|
      theorem $upZeroN {m n : Nat} (s : Idx m → $tyId n) :
          $upI s var_zero = $varI var_zero := rfl)
    -- `cases x` on an `Idx (m + 1)` produces the literal `none`/`some` ctors,
    -- which the `var_zero` pattern does not match; state both spellings.
    let upNone ← `(command|
      theorem $upNoneN {m n : Nat} (s : Idx m → $tyId n) :
          $upI s none = $varI var_zero := rfl)
    let upSome ← `(command|
      theorem $upSomeN {m n : Nat} (s : Idx m → $tyId n) (x : Idx m) :
          $upI s (some x) = $renI shift (s x) := rfl)
    -- Tag the composition / identity lemmas so the generic `asimpl` finds them.
    let tagAttr ← `(command|
      attribute [autosubst]
        $renRenN $substRenN $renSubstN $substSubstN
        $substIdN $renIdN $upIdsN $upIdsEqN $subst0SubstUpN
        $upZeroN $upNoneN $upSomeN $subst0I $substVarN $renVarN)
    pure #[renRen, upUpRen, substRen, upRenSubst, renSubst, upSubst, substSubst,
           upIds, upIdsEq, upRenId, substId, renEqSubst, renId, subst0SubstUp,
           substVar, renVar, upZero, upNone, upSome, tagAttr]

/-! ## Multi-sorted vector substitution -/

/-!
For a list of sorts `[S0, …, Sₖ]` (e.g. `[Ty, Tm]`), each sort `S` has:
* a *scope arity* = number of `Nat` indices (`Ty`→1, `Tm`→2);
* the variable sorts it *contains*, taken to be the prefix `sorts[0 : arity]`
  (so `Ty` contains `[Ty]`, `Tm` contains `[Ty, Tm]`);
* its *own* variable sort = the last contained one (`sorts[arity-1]`), the sort
  the variable constructor's `Idx` argument indexes.

Each constructor argument is classified, per the term sort's columns, as:
* a VARIABLE: an `Idx (colⱼ)` argument → apply the map for sort of column j;
* a RECURSIVE occurrence of the same sort (with per-column offsets identifying
  the bound variable sort under a binder);
* a FOREIGN subterm of another sort `F` → apply `substF`/`renF` with the prefix
  of maps matching `F`'s columns.

The generated names mirror `Autosubst2/Examples/SysF.lean`:
`renTy/upTy/substTy/idsTy`, `renTm/upTm/upTmTy/substTm/ids`, `substTy0/subst0`,
and the σ-lemma chains.
-/

/-- Per-sort static info for the multi-sort generator. -/
structure SortInfo where
  name    : Name
  /-- Capitalised suffix used in generated names, e.g. `Ty`, `Tm`. -/
  suffix  : String
  /-- Scope arity (number of `Nat` indices). -/
  arity   : Nat
  ctors   : Array CtorInfo
  deriving Inhabited

/-- A multi-sort argument classification (richer than `ArgKind`). -/
inductive MArg where
  /-- Variable: `Idx` of the column at this sort index (sort given by name). -/
  | var (sort : Name)
  /-- Recursive occurrence of the term's own sort; `offsets` per column
      (which column is `+1` identifies the bound variable sort under a binder). -/
  | recur (offsets : Array Nat)
  /-- Foreign subterm of another sort, with per-column binder `offsets` (a
      nonzero offset means the foreign subterm sits under that many binders). -/
  | foreign (sort : Name) (offsets : Array Nat)
  /-- Payload carried verbatim (e.g. `Prop`, `Nat`); never traversed by
      ren/subst.  Carries the delaborated payload type for backends that
      regenerate the inductive (the unscoped one). -/
  | other (ty : Term)
  deriving Inhabited

structure MCtor where
  name : Name
  args : Array MArg

/-- The variable constructor has exactly one `var` arg and nothing else recursive. -/
def MCtor.isVar (c : MCtor) : Bool := c.args.any fun | .var _ => true | _ => false

/-- Does this ctor bind a variable (some recursive column has `+1`)? -/
def MCtor.bound (c : MCtor) : Option Nat := Id.run do
  for a in c.args do
    match a with
    | .recur offs =>
      for i in [0:offs.size] do
        if offs[i]! > 0 then return some i
    | _ => pure ()
  return none

/-- Map a column index to the sort name (column i ↦ sorts[i]). -/
private def colSort (sorts : Array SortInfo) (i : Nat) : Name := sorts[i]!.name

/-- Analyse the whole family. Returns per-sort info and per-sort ctor data. -/
def analyseMulti (sortNames : Array Name) : MetaM (Array SortInfo × Array (Array MCtor)) := do
  let suffixOf (nm : Name) : String :=
    let s := nm.getString!
    match s.toList with
    | c :: rest => String.ofList (c.toUpper :: rest)
    | [] => s
  let mut sorts : Array SortInfo := #[]
  let mut ctorArr : Array (Array MCtor) := #[]
  for nm in sortNames do
    let .inductInfo ind ← getConstInfo nm | throwError "{nm} is not an inductive"
    let arity := ind.numIndices
    let mut mctors : Array MCtor := #[]
    for ctor in ind.ctors do
      let .ctorInfo ci ← getConstInfo ctor | throwError "bad ctor {ctor}"
      let margs ← forallTelescopeReducing ci.type fun xs body => do
        let resIdx := body.getAppArgs
        let mut margs : Array MArg := #[]
        for x in xs[ci.numParams:] do
          let xtyRaw ← inferType x
          let xty ← whnf xtyRaw
          if xty.isConstOf ``Nat && !(← x.fvarId!.getDecl).binderInfo.isExplicit then
            -- implicit `{n : Nat}` scope binder; not a real ctor argument.
            -- An *explicit* `Nat` is a payload and falls through to `.other`.
            continue
          else if xty.isAppOf ``Idx then
            let s := xty.getAppArgs[0]!
            let mut col := arity - 1
            for j in [0:arity] do
              if (resIdx[j]!).equal s then col := j
            margs := margs.push (.var sortNames[col]!)
          else
            match xty.getAppFn.constName? with
            | some headNm =>
              if headNm == nm then
                -- Recursive occurrence: read per-column binder offset from the
                -- index arithmetic (`T (m+1) n` ⇒ offsets `[1,0]`, etc.).
                let args := xty.getAppArgs
                let mut offs : Array Nat := #[]
                for j in [0:arity] do
                  offs := offs.push (addOffsetOf args[j]!)
                margs := margs.push (.recur offs)
              else if sortNames.contains headNm then
                -- Foreign subterm: record per-column binder offsets of the
                -- FOREIGN sort's own scope columns (e.g. `Expr (k+1)` in `Val`).
                let args := xty.getAppArgs
                let mut offs : Array Nat := #[]
                for j in [0:args.size] do
                  offs := offs.push (addOffsetOf args[j]!)
                margs := margs.push (.foreign headNm offs)
              else
                -- Plain non-recursive payload (e.g. `Prop`, a non-sort type):
                -- carried verbatim, never traversed.
                margs := margs.push (.other (← Lean.PrettyPrinter.delab xtyRaw))
            | none =>
              if xty.isForall then
                throwError "derive_autosubst%: functional/infinitary argument {ctor} (type {xty}) is not supported by the multi-sort backend; deeply embed it as a binder instead"
              else
                margs := margs.push (.other (← Lean.PrettyPrinter.delab xtyRaw))
        pure margs
      mctors := mctors.push { name := ctor, args := margs }
    sorts := sorts.push { name := nm, suffix := suffixOf nm, arity := arity, ctors := #[] }
    ctorArr := ctorArr.push mctors
  return (sorts, ctorArr)

/-! ### Multi-sort name helpers -/

/-- A bundle of name builders for a sort family, computed once. -/
structure MNames where
  sorts : Array SortInfo
  /-- Per-sort full variable constructor name (e.g. `Tm.var`); `none` when the
      sort has no own variable constructor (var-less, e.g. `Assn`). -/
  varCtor : Array (Option Name)
  /-- Per-sort short variable ctor (e.g. `var`); `none` for var-less sorts. -/
  varShort : Array (Option Name)
  /-- "shared substitute sort" mode: at least one sort is var-less, the whole
      family shares a single scope column and a single substitute sort (`sorts[0]`,
      the unique var-bearing sort).  This is the mutual-cycle / `{Tm, Assn}` shape;
      `false` recovers the SysF vector model. -/
  shared : Bool := false

private def lowerStr (s : String) : String :=
  match s.toList with
  | c :: rest => String.ofList (c.toLower :: rest)
  | [] => s

namespace MNames
variable (N : MNames)

def size : Nat := N.sorts.size
def isLast (i : Nat) : Bool := i + 1 == N.sorts.size

def renN  (i : Nat) : Ident := mkIdent (Name.mkSimple ("ren" ++ N.sorts[i]!.suffix))
def substN (i : Nat) : Ident := mkIdent (Name.mkSimple ("subst" ++ N.sorts[i]!.suffix))
/-- The "own up" of sort `i`.  In shared mode every sort lifts binders with the
    single substitute sort's `up` (e.g. `upTm`), so all sorts collapse to one
    shared lifting; otherwise each sort has its own `up<S>`. -/
def upN   (i : Nat) : Ident :=
  if N.shared then mkIdent (Name.mkSimple ("up" ++ N.sorts[0]!.suffix))
  else mkIdent (Name.mkSimple ("up" ++ N.sorts[i]!.suffix))
/-- Cross-sort up: `up<C><B>`, lifting map of sort `c` under a binder of sort `b`. -/
def upCrossN (c b : Nat) : Ident :=
  mkIdent (Name.mkSimple ("up" ++ N.sorts[c]!.suffix ++ N.sorts[b]!.suffix))
def idsN (i : Nat) : Ident :=
  if N.isLast i then mkIdent `ids else mkIdent (Name.mkSimple ("ids" ++ N.sorts[i]!.suffix))
def subst0N (i : Nat) : Ident :=
  if N.isLast i then mkIdent `subst0
  else mkIdent (Name.mkSimple ("subst" ++ N.sorts[i]!.suffix ++ "0"))
def tyId (i : Nat) : Ident := mkIdent N.sorts[i]!.name
/-- The family index of sort `i`'s substitute sort: in `shared` mode every sort
    substitutes into `sorts[0]` (the unique var-bearing sort); otherwise the sort
    substitutes into itself (the SysF diagonal). -/
def substIdx (i : Nat) : Nat := if N.shared then 0 else i
def varCtorI (i : Nat) : Ident := mkIdent N.varCtor[i]!.get!
def varShortI (i : Nat) : Ident := mkIdent N.varShort[i]!.get!
/-- Variable ctor of sort `i`'s substitute sort (handles var-less sorts by
    deferring to the shared substitute sort's `var`). -/
def subVarCtorI (i : Nat) : Ident := mkIdent N.varCtor[N.substIdx i]!.get!
/-- Find sort list index by name. -/
def idxOf (nm : Name) : Nat := (N.sorts.findIdx? (·.name == nm)).getD 0
/-- Renaming map variable for column-sort `j`, e.g. `xity`. -/
def xiI (j : Nat) : Ident := mkIdent (Name.mkSimple ("xi" ++ lowerStr N.sorts[j]!.suffix))
/-- Subst map variable for column-sort `j`, e.g. `sigmaty`. -/
def sigI (j : Nat) : Ident := mkIdent (Name.mkSimple ("sigma" ++ lowerStr N.sorts[j]!.suffix))

end MNames

/-! ### Multi-sort operation generation -/

/-- Apply a head identifier to a list of scope idents: `Tm d0 d1`. -/
private def appIds (hd : Ident) (xs : Array Ident) : TermElabM Term := do
  let mut t : Term := hd
  for x in xs do t ← `($t $x)
  pure t

/-- Apply a head term to a list of term arguments. -/
private def appTerms (hd : Term) (xs : Array Term) : TermElabM Term := do
  let mut t : Term := hd
  for x in xs do t ← `($t $x)
  pure t

/-- An implicit `{x0 x1 … : Nat}` binder group. -/
private def natBinder (xs : Array Ident) : TermElabM (TSyntax ``Parser.Term.bracketedBinder) :=
  `(bracketedBinder| { $xs* : Nat })

/-- An explicit `(x : ty)` binder. -/
private def expBinder (x : Ident) (ty : Term) : TermElabM (TSyntax ``Parser.Term.bracketedBinder) :=
  `(bracketedBinder| ($x : $ty))

open MNames in
/-- Generate the vector operations (`renS`, `upS`, `upCross`, `substS`, `idsS`,
`substS0`) for the whole family. -/
def genMultiOps (N : MNames) (ctorArr : Array (Array MCtor)) :
    CommandElabM (Array (TSyntax `command)) := do
  liftTermElabM do
  let mut cmds : Array (TSyntax `command) := #[]
  for si in [0:N.size] do
    let s := N.sorts[si]!
    let a := s.arity
    let mctors := ctorArr[si]!
    -- scope binder idents: domain dⱼ, codomain cⱼ
    let dom := (Array.range a).map fun j => mkIdent (Name.mkSimple s!"d{j}")
    let cod := (Array.range a).map fun j => mkIdent (Name.mkSimple s!"c{j}")
    let allScopes := (Array.range a).foldl (init := #[]) fun acc j => (acc.push dom[j]!).push cod[j]!
    let domTy ← appIds (N.tyId si) dom
    let codTy ← appIds (N.tyId si) cod

    -- helper: build the RHS map term for column j under a possible binder.
    -- `mapI j` = base map ident; `liftK j` = how many `up_ren`/`up` for ren;
    -- handled inline per op below.

    -- ===== ren =====
    let renI := N.renN si
    let xiBinders ← (Array.range a).mapM fun (j : Nat) => do
      let dj := dom[j]!; let cj := cod[j]!
      expBinder (N.xiI j) (← `(Idx $dj → Idx $cj))
    let renAlts ← mctors.mapM fun c => do
      let short := mkIdent (Name.mkSimple c.name.getString!)
      let pats := argIdents c.args.size
      let dotPat ← `(.$short:ident $pats*)
      if c.isVar then
        -- find the var column
        let col := (c.args.findSome? fun | .var nm => some (N.idxOf nm) | _ => none).getD (a-1)
        let x := pats[0]!
        `(matchAltExpr| | $dotPat => .$short:ident ($(N.xiI col) $x))
      else
        let mut rhs : Array Term := #[]
        for p in pats, arg in c.args do
          match arg with
          | .var nm => rhs := rhs.push (← `($(N.xiI (N.idxOf nm)) $p))  -- shouldn't co-occur, but safe
          | .foreign fnm _ =>
            let fi := N.idxOf fnm
            let fmaps := (Array.range N.sorts[fi]!.arity).map (N.xiI ·)
            let mut t : Term := N.renN fi
            for m in fmaps do t ← `($t $m)
            rhs := rhs.push (← `($t $p))
          | .recur offs =>
            let mut t : Term := renI
            for j in [0:a] do
              let base := N.xiI j
              let m : Term ← if offs[j]! > 0 then `(up_ren $base) else pure base
              t ← `($t $m)
            rhs := rhs.push (← `($t $p))
          | .other _ => rhs := rhs.push p
        `(matchAltExpr| | $dotPat => .$short:ident $rhs*)
    let renScope ← natBinder allScopes
    cmds := cmds.push (← `(command|
      def $renI $renScope $xiBinders* : $domTy → $codTy
        $renAlts:matchAlt*))

    -- ===== up<S> (own up) and cross ups for this sort's own var sort =====
    -- own var sort of S = column (a-1); up<S> lifts a map `Idx d_{a-1} → S … codScopes`.
    -- We generate up<S> here (the up for binding sort S's own var, column a-1).
    -- Generic shape mirrors Utlc/SysF.  In shared mode `upN` collapses every
    -- sort to the single substitute sort's `up`, so emit it only once (for `sub`).
    if !N.shared || si == N.substIdx si then do
      let upI := N.upN si
      -- The substitute sort `sub` is the sort whose VALUES fill the map: in the
      -- SysF diagonal model `sub = si`; in the shared-scope model it is `sorts[0]`.
      -- `up<S>` therefore ranges in `sub`, conses `sub`'s `var`, and shifts with
      -- `sub`'s renaming (so a var-less `Assn` reuses `Tm.var`/`renTm`).
      let sub := N.substIdx si
      let renSub := N.renN sub
      -- domain scope: one fewer in the bound column. We use generic `Idx (d+1)` form.
      -- We build: up<S> {scopes…} (sigma : Idx dlast → sub cod…) : Idx (dlast+1) → sub (cod with bound col +1)
      -- bound column for own up = a-1.
      let bcol := a - 1
      let sig := N.sigI bcol
      -- value type `sub c0 …` (prefix of `cod` of length `sub`'s arity).
      let subAr := N.sorts[sub]!.arity
      let valTy ← appIds (N.tyId sub) ((Array.range subAr).map (cod[·]!))
      let bumpedScopes := (Array.range subAr).mapM (β := Term) fun j =>
        if j == bcol then `($(cod[j]!) + 1) else `($(cod[j]!):ident)
      let bumpedScopes ← bumpedScopes
      let mut bumpedTy : Term := N.tyId sub
      for x in bumpedScopes do bumpedTy ← `($bumpedTy $x)
      -- the codomain values of sigma are renamed by shift on bound column only.
      -- ren maps: for column j: if j==bcol then `shift` else `id`.
      let mut renArgs : Array Term := #[]
      for j in [0:subAr] do
        renArgs := renArgs.push (← if j == bcol then `(shift) else `(id))
      let mut renApp : Term := renSub
      for r in renArgs do renApp ← `($renApp $r)
      -- only the implicit scopes that appear: dom[bcol], all cod.
      let scopeBinds ← natBinder (#[dom[bcol]!] ++ cod)
      let sigBinder ← expBinder sig (← `(Idx $(dom[bcol]!) → $valTy))
      cmds := cmds.push (← `(command|
        def $upI $scopeBinds $sigBinder : Idx ($(dom[bcol]!) + 1) → $bumpedTy :=
          ($(N.subVarCtorI si) var_zero) .: (fun x => $renApp ($sig x))))

    -- ===== cross ups: for each foreign carried sort b (b < a, b ≠ a-1) =====
    for bcol in [0:a] do
      if bcol != a - 1 then
        -- up<S><B>: lift map of THIS sort under a binder of carried sort bcol.
        let cI := N.upCrossN si bcol
        let sig := N.sigI bcol   -- the map being lifted is the column-bcol map? No.
        -- Actually upCross lifts the map for some OTHER sort whose values live in S.
        -- In SysF upTmTy lifts a `Idx n → Tm m1 n1` map under a ty-binder.
        -- So this is the up for sort S's OWN map (column a-1) under a binder of sort bcol.
        let mcol := a - 1
        let sigm := N.sigI mcol
        let _ := (sig, cI)
        let cvalTy ← appIds (N.tyId si) cod
        -- codomain bumps column bcol.
        let cBumpedScopes ← (Array.range a).mapM (β := Term) fun j =>
          if j == bcol then `($(cod[j]!) + 1) else `($(cod[j]!):ident)
        let mut cBumpedTy : Term := N.tyId si
        for x in cBumpedScopes do cBumpedTy ← `($cBumpedTy $x)
        -- ren shift on the bcol column, id elsewhere.
        let mut cRenArgs : Array Term := #[]
        for j in [0:a] do
          cRenArgs := cRenArgs.push (← if j == bcol then `(shift) else `(id))
        let mut cRenApp : Term := renI
        for r in cRenArgs do cRenApp ← `($cRenApp $r)
        let domLast := dom[mcol]!
        let scopeBinds ← natBinder (#[domLast] ++ cod)
        let sigBinder ← expBinder sigm (← `(Idx $domLast → $cvalTy))
        cmds := cmds.push (← `(command|
          def $cI $scopeBinds $sigBinder : Idx $domLast → $cBumpedTy :=
            fun x => $cRenApp ($sigm x)))

    -- ===== subst =====
    let substI := N.substN si
    let sigBinders ← (Array.range a).mapM fun (j : Nat) => do
      let valTy ← appIds (N.tyId (N.idxOf N.sorts[j]!.name))
        ((Array.range N.sorts[j]!.arity).map (cod[·]!))
      let dj := dom[j]!
      expBinder (N.sigI j) (← `(Idx $dj → $valTy))
    let substAlts ← mctors.mapM fun c => do
      let short := mkIdent (Name.mkSimple c.name.getString!)
      let pats := argIdents c.args.size
      let dotPat ← `(.$short:ident $pats*)
      if c.isVar then
        let col := (c.args.findSome? fun | .var nm => some (N.idxOf nm) | _ => none).getD (a-1)
        let x := pats[0]!
        `(matchAltExpr| | $dotPat => $(N.sigI col) $x)
      else
        let bound? := c.bound
        let mut rhs : Array Term := #[]
        for p in pats, arg in c.args do
          match arg with
          | .var nm => rhs := rhs.push (← `($(N.sigI (N.idxOf nm)) $p))
          | .foreign fnm _ =>
            let fi := N.idxOf fnm
            let fmaps := (Array.range N.sorts[fi]!.arity).map (N.sigI ·)
            let mut t : Term := N.substN fi
            for m in fmaps do t ← `($t $m)
            rhs := rhs.push (← `($t $p))
          | .recur _ =>
            let mut t : Term := substI
            for j in [0:a] do
              let base := N.sigI j
              let m ← match bound? with
                | some b =>
                  if j == b then `($(N.upN j) $base)            -- own up of bound sort
                  else if b < N.sorts[j]!.arity then `($(N.upCrossN j b) $base)  -- cross
                  else `($base:ident)
                | none => `($base:ident)
              t ← `($t $m)
            rhs := rhs.push (← `($t $p))
          | .other _ => rhs := rhs.push p
        `(matchAltExpr| | $dotPat => .$short:ident $rhs*)
    let substScope ← natBinder allScopes
    cmds := cmds.push (← `(command|
      def $substI $substScope $sigBinders* : $domTy → $codTy
        $substAlts:matchAlt*))

    -- ===== ids =====  (var-less sorts have no identity substitution of their own;
    -- in shared mode every column substitutes into the var-bearing sort's `ids`.)
    if N.varCtor[si]!.isSome then
      let idsScope ← natBinder dom
      cmds := cmds.push (← `(command|
        def $(N.idsN si) $idsScope : Idx $(dom[a-1]!) → $domTy := $(N.varCtorI si)))

    -- ===== subst0 (single subst of own var sort) =====
    if N.varCtor[si]!.isSome then do
      -- substS0 e u : substitute u for newest own-var (column a-1).
      -- e : S (… cols with bcol+1); maps: for own sort col a-1 use `u .: ids`,
      -- for other columns use that sort's ids.
      let bcol := a - 1
      let eScopes ← (Array.range a).mapM (β := Term) fun j =>
        if j == bcol then `($(dom[j]!) + 1) else `($(dom[j]!):ident)
      let mut eTy : Term := N.tyId si
      for x in eScopes do eTy ← `($eTy $x)
      let uTy ← appIds (N.tyId si) ((Array.range N.sorts[si]!.arity).map (dom[·]!))
      let mut substArgs : Array Term := #[]
      for j in [0:a] do
        if j == bcol then substArgs := substArgs.push (← `(u .: $(N.idsN si)))
        else substArgs := substArgs.push (N.idsN j)
      let sApp ← appTerms substI substArgs
      let s0Scope ← natBinder dom
      cmds := cmds.push (← `(command|
        def $(N.subst0N si) $s0Scope (e : $eTy) (u : $uTy) : $domTy :=
          $sApp e))
  -- In the shared-substitute-sort (mutual-cycle) mode, cross-sort operation
  -- references (`renTm` ↔ `renAssn`, `substTm` ↔ `substAssn`) form a genuine
  -- cycle with no DAG order, so all op definitions must share one `mutual` block.
  if N.shared then
    pure #[← `(command| mutual $cmds:command* end)]
  else
    pure cmds

/-! ### Multi-sort lemma generation -/

namespace MNames
variable (N : MNames)
/-- `ren<Sf>_ren<Sf>` etc. -/
def lemRenRen (i : Nat) : Ident := mkIdent (Name.mkSimple s!"ren{N.sorts[i]!.suffix}_ren{N.sorts[i]!.suffix}")
def lemSubstRen (i : Nat) : Ident := mkIdent (Name.mkSimple s!"subst{N.sorts[i]!.suffix}_ren{N.sorts[i]!.suffix}")
def lemRenSubst (i : Nat) : Ident := mkIdent (Name.mkSimple s!"ren{N.sorts[i]!.suffix}_subst{N.sorts[i]!.suffix}")
def lemSubstSubst (i : Nat) : Ident := mkIdent (Name.mkSimple s!"subst{N.sorts[i]!.suffix}_subst{N.sorts[i]!.suffix}")
def lemUpUpRen (i : Nat) : Ident := mkIdent (Name.mkSimple s!"up{N.sorts[i]!.suffix}_up_ren")
def lemUpRenSubst (i : Nat) : Ident := mkIdent (Name.mkSimple s!"up{N.sorts[i]!.suffix}_ren_subst")
def lemUpSubst (i : Nat) : Ident := mkIdent (Name.mkSimple s!"up{N.sorts[i]!.suffix}_subst")
def lemUpIds (i : Nat) : Ident := mkIdent (Name.mkSimple s!"up{N.sorts[i]!.suffix}_ids")
def lemUpIdsEq (i : Nat) : Ident := mkIdent (Name.mkSimple s!"up{N.sorts[i]!.suffix}_ids_eq")
def lemCrossIdsEq (c b : Nat) : Ident := mkIdent (Name.mkSimple s!"up{N.sorts[c]!.suffix}{N.sorts[b]!.suffix}_ids_eq")
def lemSubstId (i : Nat) : Ident := mkIdent (Name.mkSimple s!"subst{N.sorts[i]!.suffix}_id")
def lemRenIdEq (i : Nat) : Ident := mkIdent (Name.mkSimple s!"ren{N.sorts[i]!.suffix}_id_eq")
-- cross helpers (sort c lifted under binder of sort b)
def lemCrossUpRen (c b : Nat) : Ident := mkIdent (Name.mkSimple s!"up{N.sorts[c]!.suffix}{N.sorts[b]!.suffix}_up_ren")
def lemCrossRenSubst (c b : Nat) : Ident := mkIdent (Name.mkSimple s!"up{N.sorts[c]!.suffix}{N.sorts[b]!.suffix}_ren_subst")
def lemCrossSubst (c b : Nat) : Ident := mkIdent (Name.mkSimple s!"up{N.sorts[c]!.suffix}{N.sorts[b]!.suffix}_subst")
def lemCrossIds (c b : Nat) : Ident := mkIdent (Name.mkSimple s!"up{N.sorts[c]!.suffix}{N.sorts[b]!.suffix}_ids")
/-- `subst<S>_var`: subst of a variable = own-column map applied. -/
def lemSubstVar (i : Nat) : Ident := mkIdent (Name.mkSimple s!"subst{N.sorts[i]!.suffix}_var")
/-- `ren<S>_var`: ren of a variable = var of own-column renaming applied. -/
def lemRenVar (i : Nat) : Ident := mkIdent (Name.mkSimple s!"ren{N.sorts[i]!.suffix}_var")
end MNames

/-- Is sort `i` foreign-carried by some other sort (so it needs `renS_id_eq`)? -/
private def carriedElsewhere (N : MNames) (i : Nat) : Bool :=
  (Array.range N.size).any fun c => c != i && i < N.sorts[c]!.arity

/-- Build `Tm s0 s1` from a head ident and scope terms. -/
private def appHd (hd : Term) (xs : Array Term) : TermElabM Term := do
  let mut t := hd
  for x in xs do t ← `($t $x)
  pure t

/-- Per-column scope identifiers at "stage" `st` (0,1,2 give distinct names). -/
private def scopeIds (a : Nat) (prefix_ : String) : Array Ident :=
  (Array.range a).map fun j => mkIdent (Name.mkSimple s!"{prefix_}{j}")

/-- Index an `Array Ident` returning a `Term`; avoids `GetElem?`-in-antiquote
issues when splicing inside `` `(…) `` term quotations. -/
private def tm! (xs : Array Ident) (j : Nat) : Term := xs[j]!

set_option maxRecDepth 4000 in
open MNames in
/-- Generate the σ-lemma chain for a single sort `si` of the family. -/
def genSortLemmas (N : MNames) (ctorArr : Array (Array MCtor)) (si : Nat) :
    TermElabM (Array (TSyntax `command)) := do
  let s := N.sorts[si]!
  let a := s.arity
  let own := a - 1
  let mctors := ctorArr[si]!
  -- The substitute sort `sub` whose VALUES fill this sort's substitution map and
  -- `up<S>` codomain (= `si` on the SysF diagonal; `sorts[0]` in shared mode).
  -- `idsSub`/`subVar` are the substitute sort's identity and var ctor (so a
  -- var-less `Assn` reuses `idsTm`/`Tm.var`).
  let sub := N.substIdx si
  let idsSub : Ident := N.idsN sub
  -- Whether to emit this sort's OWN `up`-helper lemmas.  In shared mode every
  -- sort shares the substitute sort's `up`, so the helpers are emitted once (when
  -- `si` IS the substitute sort) and reused by name elsewhere.
  let genOwnUp := !N.shared || si == sub
  -- foreign carried columns (≠ own): these need cross-up helpers.
  let crossCols := (Array.range a).filter (· != own)
  -- value type of sort `i` applied to scope idents `sc` (prefix of length arity_i).
  let valTyOf (i : Nat) (sc : Array Ident) : TermElabM Term :=
    appIds (N.tyId i) ((Array.range N.sorts[i]!.arity).map (sc[·]!))
  -- value type of the substitute sort over scope idents `sc`.
  let subValTy (sc : Array Ident) : TermElabM Term := valTyOf sub sc
  -- the full term type `S sc0 sc1 …`
  let termTy (sc : Array Ident) : TermElabM Term := appIds (N.tyId si) sc
  let mut cmds : Array (TSyntax `command) := #[]

  -- scope name pools per stage.
  let d := scopeIds a "d"     -- stage 0 (domain)
  let e := scopeIds a "e"     -- stage 1 (mid)
  let f := scopeIds a "f"     -- stage 2 (codomain)
  -- map variable idents.
  let xiD := (Array.range a).map (fun j => mkIdent (Name.mkSimple s!"xi{j}"))   -- d→e renamings
  let zeD := (Array.range a).map (fun j => mkIdent (Name.mkSimple s!"ze{j}"))   -- e→f renamings
  let sgD := (Array.range a).map (fun j => mkIdent (Name.mkSimple s!"sg{j}"))   -- d→e substs
  let tauD := (Array.range a).map (fun j => mkIdent (Name.mkSimple s!"tau{j}")) -- e→f substs

  -- helper: implicit nat binder over a list of scope idents.
  let natB (xs : Array Ident) : TermElabM (TSyntax ``Parser.Term.bracketedBinder) := natBinder xs

  -- ===================================================================
  -- We reuse the proven single-sort template for the chain.  To keep the
  -- generator tractable and robust, the per-lemma proofs are emitted using a
  -- uniform, induction-based tactic that is valid for every sort.
  -- ===================================================================

  let asT (xs : Array Ident) : Array Term := xs.map (⟨·.raw⟩)
  let _ := asT

  -- ========================================================================
  -- IDENTITY-side lemmas (sufficient for the `substS_id` chain).
  -- These are simple `cases x` / induction proofs, fully generic.
  -- ========================================================================

  -- identity map of the SUBSTITUTE sort, ascribed to `Idx d_own → sub d0 …`.
  let idsAsc ← do
    let tdom ← subValTy d
    `(($idsSub : Idx $(d[own]!) → $tdom))

  -- `up<S>_ids`:  up<S> ids x = ids x   (own up of the identity).
  if genOwnUp then do
    let xI := mkIdent `x
    let dlast := d[own]!
    let xBinder ← expBinder xI (← `(Idx ($dlast + 1)))
    let scopeB ← natBinder d
    cmds := cmds.push (← `(command|
      theorem $(N.lemUpIds si) $scopeB $xBinder :
          $(N.upN si) $idsAsc $xI = $idsSub $xI := by
        cases $xI:ident <;> rfl))
    -- funext form, usable as a `simp only` rewrite under `subst`.
    let scopeB2 ← natBinder d
    cmds := cmds.push (← `(command|
      theorem $(N.lemUpIdsEq si) $scopeB2 :
          $(N.upN si) $idsAsc = $idsSub := by
        funext x; exact $(N.lemUpIds si) x))

  -- cross `up<S><B>_ids`:  up<S><B> ids x = ids x.
  for b in crossCols do
    let xI := mkIdent `x
    let dlast := d[own]!
    let xBinder ← expBinder xI (← `(Idx $dlast))
    let scopeB ← natBinder d
    cmds := cmds.push (← `(command|
      theorem $(N.lemCrossIds si b) $scopeB $xBinder :
          $(N.upCrossN si b) $idsAsc $xI = $(N.idsN si) $xI := rfl))
    let scopeB2 ← natBinder d
    cmds := cmds.push (← `(command|
      theorem $(N.lemCrossIdsEq si b) $scopeB2 :
          $(N.upCrossN si b) $idsAsc = $(N.idsN si) := by
        funext x; exact $(N.lemCrossIds si b) x))

  -- `subst<S>_id`:  ∀ t, subst<S> ids_for_each_col t = t  (induction on t).
  do
    let tI := mkIdent `t
    -- scope binder: ∀ {scopes}, with t : S scopes
    let scB := scopeIds a "g"
    let tTy ← appIds (N.tyId si) scB
    -- maps: identity for every column j (idsN j of that column-sort).
    let idMaps : Array Term := (Array.range a).map (fun j => (N.idsN j : Term))
    let substApp ← appHd (N.substN si) idMaps
    let alts ← mctors.mapM fun c => do
      let short := mkIdent (Name.mkSimple c.name.getString!)
      let pats := argIdents c.args.size
      let dotPat ← `(.$short:ident $pats*)
      -- one wildcard pattern column per leading implicit scope.
      let wilds : Array Term ← (Array.range a).mapM fun _ => `(_)
      let allPats : Array Term := wilds.push (← `($dotPat))
      if c.isVar then
        `(matchAltExpr| | $allPats,* => rfl)
      else
        let simpOps : Array Ident := Id.run do
          let mut r := #[N.substN si]
          for j in [0:a] do if j != si then r := r.push (N.substN j)
          pure r
        -- rewrites: substS_id for each recursive arg, substF_id for each foreign arg.
        let mut rws : Array (TSyntax ``Lean.Parser.Tactic.rwRule) := #[]
        for arg in c.args do
          match arg with
          | .recur _ => rws := rws.push (← `(Lean.Parser.Tactic.rwRule| $(N.lemSubstId si):ident))
          | .foreign fnm _ => rws := rws.push (← `(Lean.Parser.Tactic.rwRule| $(N.lemSubstId (N.idxOf fnm)):ident))
          | .var _ => pure ()
          | .other _ => pure ()
        match c.bound with
        | none =>
          if rws.isEmpty then
            `(matchAltExpr| | $allPats,* => by simp only [$[$simpOps:ident],*])
          else
            `(matchAltExpr| | $allPats,* => by simp only [$[$simpOps:ident],*]; rw [$[$rws],*])
        | some b =>
          -- the lifted identity maps reduce to `ids` via the funext-form lemmas;
          -- feed them (and the up-defs) to `simp only`, then apply IHs.
          let mut idEqs : Array Ident := #[N.lemUpIdsEq b]
          -- the own-column map (when it carries `b`) lifts via the cross-up `upSB`.
          if b != own && b < a then idEqs := idEqs.push (N.lemCrossIdsEq si b)
          let simpAll := simpOps ++ idEqs
          if rws.isEmpty then
            `(matchAltExpr| | $allPats,* => by simp only [$[$simpAll:ident],*])
          else
            `(matchAltExpr| | $allPats,* => by
                simp only [$[$simpAll:ident],*]
                rw [$[$rws],*])
    cmds := cmds.push (← `(command|
      theorem $(N.lemSubstId si) : ∀ { $scB* : Nat } ($tI : $tTy),
          $substApp $tI = $tI
        $alts:matchAlt*))

  -- ========================================================================
  -- COMPOSITION CHAIN.
  -- ========================================================================
  -- Per-sort helpers for building applied operations and types.

  -- value type of sort `i` over scope idents `sc` (full scope array, we take prefix)
  -- `valTyOf` is defined above.
  -- ren/subst of THIS sort applied to a full array of `a` map terms.
  let renAppT (maps : Array Term) : TermElabM Term := appHd (N.renN si) maps
  let substAppT (maps : Array Term) : TermElabM Term := appHd (N.substN si) maps
  -- foreign: ren/subst of sort `i` applied to the prefix of column maps `maps`.
  let renForeignT (i : Nat) (maps : Array Term) : TermElabM Term :=
    appHd (N.renN i) ((Array.range N.sorts[i]!.arity).map (maps[·]!))
  let substForeignT (i : Nat) (maps : Array Term) : TermElabM Term :=
    appHd (N.substN i) ((Array.range N.sorts[i]!.arity).map (maps[·]!))

  -- The columns that get lifted under a binder of column `b`, as
  -- `(col, isCross)` where `isCross = (col ≠ b)` means use the cross-up helper.
  let liftsUnder (b : Nat) : Array (Nat × Bool) := Id.run do
    let mut r : Array (Nat × Bool) := #[(b, false)]
    if b != own && b < a then r := r.push (own, true)
    return r

  -- Richer lift spec under a binder of column `b`:
  -- `(col, sortIdx, isCross)`.  The bound column `b` lifts via the OWN up of the
  -- sort sitting at column `b` (e.g. `upTy` for a type binder); the term's own
  -- column (when `b ≠ own`) lifts via the cross up `upS_b` (e.g. `upTmTy`).
  let liftSpec (b : Nat) : Array (Nat × Nat × Bool) := Id.run do
    let mut r : Array (Nat × Nat × Bool) := #[(b, N.idxOf N.sorts[b]!.name, false)]
    if b != own && b < a then r := r.push (own, si, true)
    return r
  let _ := liftsUnder

  -- Generic induction over the term sort for a "∀ t, LHS = RHS" composition
  -- lemma.  `selfN` is the lemma's own name (the IH).  `simpDefs` are the
  -- operation idents to unfold per non-var ctor.  `foreignLemma i` gives the
  -- foreign sort's analogous lemma name.  `binderHaves b` builds the binder
  -- `have`/`rw` block for a binder of column `b`.
  let mkCompAlts (selfN : Ident) (simpDefs : Array Ident)
      (foreignLemma : Nat → Ident)
      (binderHaves : Nat → TermElabM (TSyntax `tactic)) :
      TermElabM (Array (TSyntax ``Parser.Term.matchAlt)) :=
    mctors.mapM fun c => do
      let short := mkIdent (Name.mkSimple c.name.getString!)
      let pats := argIdents c.args.size
      let dotPat ← `(.$short:ident $pats*)
      if c.isVar then
        `(matchAltExpr| | $dotPat => rfl)
      else
        -- rewrites: self IH per recursive arg, foreign lemma per foreign arg.
        let mut rws : Array (TSyntax ``Lean.Parser.Tactic.rwRule) := #[]
        for arg in c.args do
          match arg with
          | .recur _ => rws := rws.push (← `(Lean.Parser.Tactic.rwRule| $selfN:ident))
          | .foreign fnm _ => rws := rws.push (← `(Lean.Parser.Tactic.rwRule| $(foreignLemma (N.idxOf fnm)):ident))
          | .var _ => pure ()
          | .other _ => pure ()
        match c.bound with
        | none =>
          if rws.isEmpty then
            `(matchAltExpr| | $dotPat => by simp only [$[$simpDefs:ident],*])
          else
            `(matchAltExpr| | $dotPat => by simp only [$[$simpDefs:ident],*]; rw [$[$rws],*])
        | some b =>
          let hav ← binderHaves b
          `(matchAltExpr| | $dotPat => by
              simp only [$[$simpDefs:ident],*]
              rw [$[$rws],*]
              $hav:tactic)

  -- simp defs used by the four lemmas (own ren/subst + foreign ren/subst).
  let foreignSorts : Array Nat := (Array.range a).filter (· != own)
  let renDefs : Array Ident := Id.run do
    let mut r := #[N.renN si]
    for j in foreignSorts do r := r.push (N.renN (N.idxOf N.sorts[j]!.name))
    pure r
  let substDefs : Array Ident := Id.run do
    let mut r := #[N.substN si]
    for j in foreignSorts do r := r.push (N.substN (N.idxOf N.sorts[j]!.name))
    pure r
  let renSubstDefs : Array Ident := renDefs ++ substDefs

  -- ---- helper lemmas (up-commutation) -------------------------------------
  -- These quantify over a `k`-scope and a `+1` binder of the bound sort.
  -- We name fresh scope idents to avoid clashes.
  -- For each binder-column `b` we emit, per main lemma, an `upS[_B]_*` helper.

  -- scope idents for helper statements: domain `p`, mid `q`, codomain `r`,
  -- and the bound binder scope `k`.
  let pSc := scopeIds a "p"
  let qSc := scopeIds a "q"
  let rSc := scopeIds a "r"
  let kI := mkIdent `k

  -- value type of sort `i` at scope-array `sc`.
  let vTy (i : Nat) (sc : Array Ident) : TermElabM Term :=
    appIds (N.tyId i) ((Array.range N.sorts[i]!.arity).map (sc[·]!))

  -- A renaming-map ident pool for helper statements (one per column), and
  -- subst-map pool, fresh names.
  let xiH := (Array.range a).map (fun j => mkIdent (Name.mkSimple s!"hxi{j}"))
  let zeH := (Array.range a).map (fun j => mkIdent (Name.mkSimple s!"hze{j}"))
  let sgH := (Array.range a).map (fun j => mkIdent (Name.mkSimple s!"hsg{j}"))
  let tauH := (Array.range a).map (fun j => mkIdent (Name.mkSimple s!"htau{j}"))
  let _ := (zeH, tauH)


  -- ========================================================================
  -- 1. renS_renS
  -- ========================================================================
  do
    let selfN := N.lemRenRen si
    -- statement: ∀ t, renS ze (renS xi t) = renS (fun x => ze (xi x)) t
    let xiBs ← (Array.range a).mapM fun j => do
      expBinder (xiD[j]!) (← `(Idx $(tm! d j) → Idx $(tm! e j)))
    let zeBs ← (Array.range a).mapM fun j => do
      expBinder (zeD[j]!) (← `(Idx $(tm! e j) → Idx $(tm! f j)))
    let innerT ← renAppT ((Array.range a).map (xiD[·]! : Nat → Term))
    let outerT ← renAppT ((Array.range a).map (zeD[·]! : Nat → Term))
    let compMaps ← (Array.range a).mapM fun j =>
      `(fun x => $(tm! zeD j) ($(tm! xiD j) x))
    let rhsT ← renAppT compMaps
    let tTy ← appIds (N.tyId si) d
    -- binder haves: for each lifted column, an `up_ren_ren` based have.
    let binderHaves (b : Nat) : TermElabM (TSyntax `tactic) := do
      -- renaming only lifts the bound column (no cross shift).
      let lifts : Array (Nat × Bool) := #[(b, false)]
      let mut tacs : Array (TSyntax `tactic) := #[]
      let mut hns : Array (TSyntax ``Lean.Parser.Tactic.rwRule) := #[]
      for (col, _) in lifts do
        let hn := mkIdent (Name.mkSimple s!"h{col}")
        let lhs ← `(fun x => up_ren $(tm! zeD col) (up_ren $(tm! xiD col) x))
        let rhs ← `(up_ren (fun x => $(tm! zeD col) ($(tm! xiD col) x)))
        tacs := tacs.push (← `(tactic|
          have $hn:ident : $lhs = $rhs := by
            funext x; exact up_ren_ren $(tm! xiD col) $(tm! zeD col) _ (fun _ => rfl) x))
        hns := hns.push (← `(Lean.Parser.Tactic.rwRule| $hn:ident))
      `(tactic| ($[$tacs:tactic]*; rw [$[$hns],*]))
    let alts ← mkCompAlts selfN renDefs (fun i => N.lemRenRen i) binderHaves
    cmds := cmds.push (← `(command|
      theorem $selfN { $d* $e* $f* : Nat } $xiBs* $zeBs* :
          ∀ t : $tTy, $outerT ($innerT t) = $rhsT t
        $alts:matchAlt*))

  -- ========================================================================
  -- 2. up helpers for subst_ren  (upS[_B]_up_ren)
  -- ========================================================================
  -- upS_up_ren: own binder. Cross helper upS_B_up_ren for each cross col.
  -- own:
  if genOwnUp then do
    -- own up helper: upS sigma (up_ren xi x) = upS (fun y => sigma (xi y)) x
    -- scopes: domain p[own], a fresh k, codomain q for all cols.
    let selfN := N.lemUpUpRen si
    let sig := mkIdent `sigma
    let xi := mkIdent `xi
    let valT ← subValTy qSc
    let sigB ← expBinder sig (← `(Idx $kI → $valT))
    let _ := pSc
    -- domain of xi is a new scope `dd`, codomain `k`.
    let dI := mkIdent `dd
    let xI := mkIdent `x
    let scB ← natBinder (#[dI, kI] ++ qSc)
    let xiB ← expBinder xi (← `(Idx $dI → Idx $kI))
    let xBnd ← expBinder xI (← `(Idx ($dI + 1)))
    cmds := cmds.push (← `(command|
      theorem $selfN $scB $sigB $xiB $xBnd :
          $(N.upN si) $sig (up_ren $xi $xI)
            = $(N.upN si) (fun y => $sig ($xi y)) $xI := by
        cases $xI:ident <;> simp [$(N.upN si):ident, up_ren, scons, shift, var_zero]))
  -- cross helpers: upS_B_up_ren  (rfl — renaming passes through)
  for b in crossCols do
    let selfN := N.lemCrossUpRen si b
    let sig := mkIdent `sigma
    let xi := mkIdent `xi
    let valT ← vTy si qSc
    let dI := mkIdent `dd
    let kI2 := mkIdent `k
    let scB ← natBinder (#[dI, kI2] ++ qSc)
    let sigB ← expBinder sig (← `(Idx $kI2 → $valT))
    let xI := mkIdent `x
    let xiB ← expBinder xi (← `(Idx $dI → Idx $kI2))
    let xBnd ← expBinder xI (← `(Idx $dI))
    cmds := cmds.push (← `(command|
      theorem $selfN $scB $sigB $xiB $xBnd :
          $(N.upCrossN si b) $sig ($xi $xI)
            = $(N.upCrossN si b) (fun y => $sig ($xi y)) $xI := rfl))

  -- ========================================================================
  -- 3. substS_renS
  -- ========================================================================
  do
    let selfN := N.lemSubstRen si
    -- subst maps sg (e→f value), ren maps xi (d→e).
    let sgBs ← (Array.range a).mapM fun j => do
      let vt ← vTy j f
      expBinder (sgD[j]!) (← `(Idx $(tm! e j) → $vt))
    let xiBs ← (Array.range a).mapM fun j => do
      expBinder (xiD[j]!) (← `(Idx $(tm! d j) → Idx $(tm! e j)))
    let innerT ← renAppT ((Array.range a).map (xiD[·]! : Nat → Term))
    let outerT ← substAppT ((Array.range a).map (sgD[·]! : Nat → Term))
    let compMaps ← (Array.range a).mapM fun j =>
      `(fun x => $(tm! sgD j) ($(tm! xiD j) x))
    let rhsT ← substAppT compMaps
    let tTy ← appIds (N.tyId si) d
    let binderHaves (b : Nat) : TermElabM (TSyntax `tactic) := do
      let lifts := liftSpec b
      let mut tacs : Array (TSyntax `tactic) := #[]
      let mut hns : Array (TSyntax ``Lean.Parser.Tactic.rwRule) := #[]
      for (col, sortIdx, isCross) in lifts do
        let hn := mkIdent (Name.mkSimple s!"h{col}")
        let upI := if isCross then N.upCrossN si b else N.upN sortIdx
        let helperN := if isCross then N.lemCrossUpRen si b else N.lemUpUpRen sortIdx
        let liftXi ← if isCross then pure (xiD[col]! : Term) else `(up_ren $(tm! xiD col))
        let lhs ← `(fun x => $upI $(tm! sgD col) ($liftXi x))
        let rhs ← `($upI (fun x => $(tm! sgD col) ($(tm! xiD col) x)))
        tacs := tacs.push (← `(tactic|
          have $hn:ident : $lhs = $rhs := by
            funext x; exact $helperN $(tm! sgD col) $(tm! xiD col) x))
        hns := hns.push (← `(Lean.Parser.Tactic.rwRule| $hn:ident))
      `(tactic| ($[$tacs:tactic]*; rw [$[$hns],*]))
    let alts ← mkCompAlts selfN renSubstDefs (fun i => N.lemSubstRen i) binderHaves
    cmds := cmds.push (← `(command|
      theorem $selfN { $d* $e* $f* : Nat } $sgBs* $xiBs* :
          ∀ t : $tTy, $outerT ($innerT t) = $rhsT t
        $alts:matchAlt*))

  -- ========================================================================
  -- 4. up helpers for ren_subst  (upS[_B]_ren_subst)
  -- ========================================================================
  if genOwnUp then do
    -- own: upS (fun y => renS xi (sigma y)) x = renS (up_ren xi) (upS sigma x)
    let selfN := N.lemUpRenSubst si
    let sig := mkIdent `sigma
    -- xi renamings: one per column of THIS sort (e→f), but the value of sigma
    -- is a full sort-`si` term, so we need a ren map per column of si.
    let xiC := (Array.range a).map (fun j => mkIdent (Name.mkSimple s!"xi{j}"))
    let xiBs ← (Array.range a).mapM fun j => do
      expBinder (xiC[j]!) (← `(Idx $(tm! e j) → Idx $(tm! f j)))
    let valT ← subValTy e
    let sigB ← expBinder sig (← `(Idx $(tm! d own) → $valT))
    let xI := mkIdent `x
    let xBnd ← expBinder xI (← `(Idx ($(tm! d own) + 1)))
    -- LHS: upS (fun y => renS xi (sigma y)) x
    let renXi ← renAppT ((Array.range a).map (xiC[·]! : Nat → Term))
    let lhsBody ← `(fun y => $renXi ($sig y))
    -- RHS: renS (lift xi per col under own binder) (upS sigma x)
    let rhsRenMaps ← (Array.range a).mapM fun j =>
      if j == own then `(up_ren $(tm! xiC j)) else pure (xiC[j]! : Term)
    let renLift ← renAppT rhsRenMaps
    let upSig ← `($(N.upN si) $sig $xI)
    -- proof: cases x; none => rfl; some y => simp [upN, scons, shift]; rw renS_renS twice; rfl
    let renRenN := N.lemRenRen si
    cmds := cmds.push (← `(command|
      theorem $selfN $xiBs* $sigB $xBnd :
          $(N.upN si) $lhsBody $xI = $renLift $upSig := by
        cases $xI:ident with
        | none => rfl
        | some y =>
          simp only [$(N.upN si):ident, scons, shift]
          rw [$renRenN:term, $renRenN:term]
          rfl))
  for b in crossCols do
    -- cross: upS_B (fun y => renS xi (sigma y)) x = renS (lift xi at col b) (upS_B sigma x)
    let selfN := N.lemCrossRenSubst si b
    let sig := mkIdent `sigma
    let xiC := (Array.range a).map (fun j => mkIdent (Name.mkSimple s!"xi{j}"))
    let xiBs ← (Array.range a).mapM fun j => do
      expBinder (xiC[j]!) (← `(Idx $(tm! e j) → Idx $(tm! f j)))
    let valT ← vTy si e
    let sigB ← expBinder sig (← `(Idx $(tm! d own) → $valT))
    let xI := mkIdent `x
    let xBnd ← expBinder xI (← `(Idx $(tm! d own)))
    let renXi ← renAppT ((Array.range a).map (xiC[·]! : Nat → Term))
    let lhsBody ← `(fun y => $renXi ($sig y))
    let rhsRenMaps ← (Array.range a).mapM fun j =>
      if j == b then `(up_ren $(tm! xiC j)) else pure (xiC[j]! : Term)
    let renLift ← renAppT rhsRenMaps
    let upSig ← `($(N.upCrossN si b) $sig $xI)
    let renRenN := N.lemRenRen si
    cmds := cmds.push (← `(command|
      theorem $selfN $xiBs* $sigB $xBnd :
          $(N.upCrossN si b) $lhsBody $xI = $renLift $upSig := by
        simp only [$(N.upCrossN si b):ident]
        rw [$renRenN:term, $renRenN:term]
        rfl))

  -- ========================================================================
  -- 5. renS_substS
  -- ========================================================================
  do
    let selfN := N.lemRenSubst si
    -- xi ren maps (e→f), sigma subst maps (d→e value).
    let xiBs ← (Array.range a).mapM fun j => do
      expBinder (xiD[j]!) (← `(Idx $(tm! e j) → Idx $(tm! f j)))
    let sgBs ← (Array.range a).mapM fun j => do
      let vt ← vTy j e
      expBinder (sgD[j]!) (← `(Idx $(tm! d j) → $vt))
    let innerT ← substAppT ((Array.range a).map (sgD[·]! : Nat → Term))
    let outerT ← renAppT ((Array.range a).map (xiD[·]! : Nat → Term))
    -- rhs maps: column j ↦ fun x => ren_{sort j} (xi prefix) (sg[j] x)
    let compMaps ← (Array.range a).mapM fun j => do
      let sj := N.idxOf N.sorts[j]!.name
      let renPref ← renForeignT sj ((Array.range a).map (xiD[·]! : Nat → Term))
      `(fun x => $renPref ($(tm! sgD j) x))
    let rhsT ← substAppT compMaps
    let tTy ← appIds (N.tyId si) d
    let binderHaves (b : Nat) : TermElabM (TSyntax `tactic) := do
      let lifts := liftSpec b
      let mut tacs : Array (TSyntax `tactic) := #[]
      let mut hns : Array (TSyntax ``Lean.Parser.Tactic.rwRule) := #[]
      for (col, sortIdx, isCross) in lifts do
        let hn := mkIdent (Name.mkSimple s!"h{col}")
        let upI := if isCross then N.upCrossN si b else N.upN sortIdx
        let helperN := if isCross then N.lemCrossRenSubst si b else N.lemUpRenSubst sortIdx
        let helperSort := if isCross then si else sortIdx
        let hAr := N.sorts[helperSort]!.arity
        -- ren maps for the helper sort's columns, up_ren at the bound col `b`.
        let liftXi ← (Array.range hAr).mapM fun k =>
          if k == b then `(up_ren $(tm! xiD k)) else pure (xiD[k]! : Term)
        let renLift ← appHd (N.renN helperSort) liftXi
        let plainXi := (Array.range hAr).map (xiD[·]! : Nat → Term)
        let renPlain ← appHd (N.renN helperSort) plainXi
        let upSig ← `($upI $(tm! sgD col) x)
        let lhs ← `(fun x => $renLift ($upSig))
        let rhs ← `($upI (fun x => $renPlain ($(tm! sgD col) x)))
        let callArgs := plainXi.push (tm! sgD col)
        let helperApp ← appHd helperN callArgs
        tacs := tacs.push (← `(tactic|
          have $hn:ident : $lhs = $rhs := by
            funext x; exact ($helperApp x).symm))
        hns := hns.push (← `(Lean.Parser.Tactic.rwRule| $hn:ident))
      `(tactic| ($[$tacs:tactic]*; rw [$[$hns],*]))
    let alts ← mkCompAlts selfN renSubstDefs (fun i => N.lemRenSubst i) binderHaves
    cmds := cmds.push (← `(command|
      theorem $selfN { $d* $e* $f* : Nat } $xiBs* $sgBs* :
          ∀ t : $tTy, $outerT ($innerT t) = $rhsT t
        $alts:matchAlt*))

  -- ========================================================================
  -- renS_id_eq (only if `si` is carried by another sort as a foreign value)
  -- ========================================================================
  -- needed for upS_subst cross cleanup; generate when carriedElsewhere.  Not
  -- needed in shared mode (single column ⇒ no cross-column `id`-renaming cleanup),
  -- and its `induction` proof would fail on the mutually-inductive sorts anyway.
  if carriedElsewhere N si && !N.shared then do
    let selfN := N.lemRenIdEq si
    let tI := mkIdent `t
    let scB := scopeIds a "g"
    let tTy ← appIds (N.tyId si) scB
    -- induction-based proof (mirrors SysF `renTy_id_eq`).
    let wild : Term ← `(_)
    let alts ← mctors.mapM fun c => do
      let short := mkIdent (Name.mkSimple c.name.getString!)
      -- field binders: `_` for every explicit field; IH idents for recursive args.
      let mut binds : Array Term := #[]
      for _ in c.args do binds := binds.push wild
      let mut ihs : Array Ident := #[]
      let mut idx := 0
      for arg in c.args do
        match arg with
        | .recur _ => ihs := ihs.push (mkIdent (Name.mkSimple s!"ih{idx}")); idx := idx + 1
        | _ => pure ()
      let rawBinds : Array Syntax := binds.map (·.raw) ++ ihs.map (·.raw)
      let allBinds : TSyntaxArray [`ident, `Lean.Parser.Term.hole] := rawBinds.map (⟨·⟩)
      if c.isVar then
        `(Lean.Parser.Tactic.inductionAlt| | $short:ident $allBinds* => rfl)
      else
        let rws : Array (TSyntax ``Lean.Parser.Tactic.rwRule) ←
          ihs.mapM (fun i => `(Lean.Parser.Tactic.rwRule| $i:ident))
        match c.bound with
        | none =>
          `(Lean.Parser.Tactic.inductionAlt| | $short:ident $allBinds* =>
              simp only [$(N.renN si):ident]; rw [$[$rws],*])
        | some _ =>
          let hn := mkIdent `h
          `(Lean.Parser.Tactic.inductionAlt| | $short:ident $allBinds* =>
              simp only [$(N.renN si):ident]
              have $hn:ident : ∀ {p : Nat}, up_ren (id : Idx p → Idx p) = id := by
                intro p; funext x; cases x <;> rfl
              rw [$hn:ident, $[$rws],*])
    cmds := cmds.push (← `(command|
      theorem $selfN { $scB* : Nat } ($tI : $tTy) : $(N.renN si) id $tI = $tI := by
        induction $tI:ident with
        $alts:inductionAlt*))

  -- ========================================================================
  -- 6. up helpers for subst_subst  (upS[_B]_subst)
  -- ========================================================================
  if genOwnUp then do
    -- own: upS (fun y => substS tau (sigma y)) x = substS (upS_each tau) (upS sigma x)
    let selfN := N.lemUpSubst si
    let sig := mkIdent `sigma
    -- tau subst maps, one per column of THIS sort: column j value sort `j`, e→f.
    let tauC := (Array.range a).map (fun j => mkIdent (Name.mkSimple s!"tau{j}"))
    let tauBs ← (Array.range a).mapM fun j => do
      let vt ← vTy j f
      expBinder (tauC[j]!) (← `(Idx $(tm! e j) → $vt))
    let valT ← subValTy e
    let xI := mkIdent `x
    let sigB ← expBinder sig (← `(Idx $(tm! d own) → $valT))
    let xBnd ← expBinder xI (← `(Idx ($(tm! d own) + 1)))
    let substTau ← substAppT ((Array.range a).map (tauC[·]! : Nat → Term))
    let lhsBody ← `(fun y => $substTau ($sig y))
    -- RHS substS with tau lifted: own col -> upN own; cross cols of si -> upCrossN own? No.
    -- Under own binder, lift each column's tau: col own -> upN own; other cols j ->
    -- if own < arity_j then upCrossN j own else tau unchanged.
    let rhsTau ← (Array.range a).mapM fun j =>
      if j == own then `($(N.upN own) $(tm! tauC j))
      else if own < N.sorts[j]!.arity then `($(N.upCrossN (N.idxOf N.sorts[j]!.name) own) $(tm! tauC j))
      else pure (tauC[j]! : Term)
    let substLift ← substAppT rhsTau
    let upSig ← `($(N.upN si) $sig $xI)
    let renSubstN := N.lemRenSubst si
    let substRenN := N.lemSubstRen si
    -- foreign columns (≠ own) are renamed by `id` inside `upN`; clean them up via
    -- `ren_{sort}_id_eq` so the type-substitution column matches its un-renamed form.
    let mut cleanTacs : Array (TSyntax `tactic) := #[]
    let mut cleanHns : Array (TSyntax ``Lean.Parser.Tactic.rwRule) := #[]
    for k in [0:a] do
      if k != own then
        let sk := N.idxOf N.sorts[k]!.name
        let idMaps ← (Array.range N.sorts[sk]!.arity).mapM fun _ => `(id)
        let renApp ← appHd (N.renN sk) idMaps
        let hn := mkIdent (Name.mkSimple s!"hcl{k}")
        cleanTacs := cleanTacs.push (← `(tactic|
          have $hn:ident : (fun x => $renApp ($(tm! tauC k) x)) = $(tm! tauC k) := by
            funext z; rw [$(N.lemRenIdEq sk):term]))
        cleanHns := cleanHns.push (← `(Lean.Parser.Tactic.rwRule| $hn:ident))
    let cleanupTac ← if cleanHns.isEmpty then `(tactic| rfl)
      else `(tactic| ($[$cleanTacs:tactic]*; rw [$[$cleanHns],*]; rfl))
    cmds := cmds.push (← `(command|
      theorem $selfN $sigB $tauBs* $xBnd :
          $(N.upN si) $lhsBody $xI = $substLift $upSig := by
        cases $xI:ident with
        | none => rfl
        | some y =>
          simp only [$(N.upN si):ident, scons, shift]
          rw [$renSubstN:term, $substRenN:term]
          $cleanupTac:tactic))
  for b in crossCols do
    -- cross: upS_B (fun y => substS tau (sigma y)) x
    --        = substS (tau lifted under b-binder) (upS_B sigma x)
    let selfN := N.lemCrossSubst si b
    let sig := mkIdent `sigma
    let tauC := (Array.range a).map (fun j => mkIdent (Name.mkSimple s!"tau{j}"))
    let tauBs ← (Array.range a).mapM fun j => do
      let vt ← vTy j f
      expBinder (tauC[j]!) (← `(Idx $(tm! e j) → $vt))
    let valT ← vTy si e
    let xI := mkIdent `x
    let sigB ← expBinder sig (← `(Idx $(tm! d own) → $valT))
    let xBnd ← expBinder xI (← `(Idx $(tm! d own)))
    let substTau ← substAppT ((Array.range a).map (tauC[·]! : Nat → Term))
    let lhsBody ← `(fun y => $substTau ($sig y))
    let rhsTau ← (Array.range a).mapM fun j =>
      if j == b then `($(N.upN b) $(tm! tauC j))
      else if b < N.sorts[j]!.arity then `($(N.upCrossN (N.idxOf N.sorts[j]!.name) b) $(tm! tauC j))
      else pure (tauC[j]! : Term)
    let substLift ← substAppT rhsTau
    let upSig ← `($(N.upCrossN si b) $sig $xI)
    let renSubstN := N.lemRenSubst si
    let substRenN := N.lemSubstRen si
    -- The cross proof: simp [upS_B]; rw renS_substS, substS_renS; then funext haves
    -- to massage the renamed/substituted columns into up forms; rfl after.
    -- For SysF upTmTy_subst: two haves rewriting `renTy shift` ↦ `upTy tauty ∘ shift`
    -- and `renTm shift id` ↦ `upTmTy tautm ∘ id`. Generic: for each column of si,
    -- a have identifying `fun x => ren_{sort j} (shift at b, id else) (tau_j x)`
    -- with `fun x => up*_{j} tau_j (idmap x)`.  These are all `rfl`.
    let mut haveTacs : Array (TSyntax `tactic) := #[]
    let mut hns : Array (TSyntax ``Lean.Parser.Tactic.rwRule) := #[]
    for j in [0:a] do
      let sj := N.idxOf N.sorts[j]!.name
      -- ren maps for sort j prefix: column k of sj is shift if (k == b) else id.
      let renMaps ← (Array.range N.sorts[sj]!.arity).mapM fun k =>
        if k == b then `(shift) else `(id)
      let renPref ← appHd (N.renN sj) renMaps
      let lhs ← `(fun x => $renPref ($(tm! tauC j) x))
      -- rhs: up form. For the bound column b's own sort, that's upN b applied; for
      -- column own of si lifted under cross b -> upCrossN sj b.
      let upForm : Term ←
        if j == b then `($(N.upN b) $(tm! tauC j))
        else if b < N.sorts[sj]!.arity then `($(N.upCrossN sj b) $(tm! tauC j))
        else pure (tauC[j]! : Term)
      -- index transform inside upForm: `shift` for the bound column, `id` else
      -- (mirrors SysF `upTmTy_subst`'s hty/htm).
      let idxMap : Term ← if j == b then `(shift) else `(id)
      let rhs ← `(fun x => $upForm ($idxMap x))
      let hn := mkIdent (Name.mkSimple s!"hc{j}")
      haveTacs := haveTacs.push (← `(tactic| have $hn:ident : $lhs = $rhs := by funext z; rfl))
      hns := hns.push (← `(Lean.Parser.Tactic.rwRule| $hn:ident))
    let _ := (substLift, renSubstN, substRenN, lhsBody, upSig)
    cmds := cmds.push (← `(command|
      theorem $selfN $sigB $tauBs* $xBnd :
          $(N.upCrossN si b) $lhsBody $xI = $substLift $upSig := by
        simp only [$(N.upCrossN si b):ident]
        rw [$(N.lemRenSubst si):term, $(N.lemSubstRen si):term]
        $[$haveTacs:tactic]*
        rw [$[$hns],*]))

  -- ========================================================================
  -- 7. substS_substS
  -- ========================================================================
  do
    let selfN := N.lemSubstSubst si
    let sgBs ← (Array.range a).mapM fun j => do
      let vt ← vTy j e
      expBinder (sgD[j]!) (← `(Idx $(tm! d j) → $vt))
    let tauC := (Array.range a).map (fun j => mkIdent (Name.mkSimple s!"tau{j}"))
    let tauBs ← (Array.range a).mapM fun j => do
      let vt ← vTy j f
      expBinder (tauC[j]!) (← `(Idx $(tm! e j) → $vt))
    let innerT ← substAppT ((Array.range a).map (sgD[·]! : Nat → Term))
    let outerT ← substAppT ((Array.range a).map (tauC[·]! : Nat → Term))
    let compMaps ← (Array.range a).mapM fun j => do
      let sj := N.idxOf N.sorts[j]!.name
      let substPref ← substForeignT sj ((Array.range a).map (tauC[·]! : Nat → Term))
      `(fun x => $substPref ($(tm! sgD j) x))
    let rhsT ← substAppT compMaps
    let tTy ← appIds (N.tyId si) d
    let binderHaves (b : Nat) : TermElabM (TSyntax `tactic) := do
      let lifts := liftSpec b
      let mut tacs : Array (TSyntax `tactic) := #[]
      let mut hns : Array (TSyntax ``Lean.Parser.Tactic.rwRule) := #[]
      for (col, sortIdx, isCross) in lifts do
        let hn := mkIdent (Name.mkSimple s!"h{col}")
        let upI := if isCross then N.upCrossN si b else N.upN sortIdx
        let helperN := if isCross then N.lemCrossSubst si b else N.lemUpSubst sortIdx
        let helperSort := if isCross then si else sortIdx
        let hAr := N.sorts[helperSort]!.arity
        -- tau maps for the helper sort's columns, lifted under a `b`-binder.
        let liftTau ← (Array.range hAr).mapM fun k => do
          if k == b then `($(N.upN b) $(tm! tauC k))
          else if b < N.sorts[k]!.arity then
            `($(N.upCrossN (N.idxOf N.sorts[k]!.name) b) $(tm! tauC k))
          else pure (tauC[k]! : Term)
        let substLift ← appHd (N.substN helperSort) liftTau
        let plainTau := (Array.range hAr).map (tauC[·]! : Nat → Term)
        let substPlain ← appHd (N.substN helperSort) plainTau
        let upSig ← `($upI $(tm! sgD col) x)
        let lhs ← `(fun x => $substLift ($upSig))
        let rhs ← `($upI (fun x => $substPlain ($(tm! sgD col) x)))
        let callArgs := #[(tm! sgD col)] ++ plainTau
        let helperApp ← appHd helperN callArgs
        tacs := tacs.push (← `(tactic|
          have $hn:ident : $lhs = $rhs := by
            funext x; exact ($helperApp x).symm))
        hns := hns.push (← `(Lean.Parser.Tactic.rwRule| $hn:ident))
      `(tactic| ($[$tacs:tactic]*; rw [$[$hns],*]))
    let alts ← mkCompAlts selfN substDefs (fun i => N.lemSubstSubst i) binderHaves
    cmds := cmds.push (← `(command|
      theorem $selfN { $d* $e* $f* : Nat } $sgBs* $tauBs* :
          ∀ t : $tTy, $outerT ($innerT t) = $rhsT t
        $alts:matchAlt*))

  -- ========================================================================
  -- 8. subst0_subst_up  (only on the LAST/own-most sort, like SysF; in shared
  --    mode on the substitute sort, which is the one that has `subst0`).
  -- ========================================================================
  if (if N.shared then si == sub else N.isLast si) then do
    let selfN := mkIdent `subst0_subst_up
    let sig := mkIdent `sigma
    let eI := mkIdent `e
    let uI := mkIdent `u
    -- sigma : Idx d[own] → S d... (own var subst); e : S (d with own +1); u : S d.
    let valT ← vTy si d
    let sigB ← expBinder sig (← `(Idx $(tm! d own) → $valT))
    let eScopes ← (Array.range a).mapM (β := Term) fun j =>
      if j == own then `($(tm! d j) + 1) else pure (tm! d j)
    let mut eTy : Term := N.tyId si
    for x in eScopes do eTy ← `($eTy $x)
    let eB ← expBinder eI eTy
    let uB ← expBinder uI valT
    -- LHS: subst0 (substS (own col upS sigma, other cols ids) e) u
    let substArgs ← (Array.range a).mapM fun j =>
      if j == own then `($(N.upN si) $sig)
      else pure (N.idsN j : Term)
    let substApp ← substAppT substArgs
    -- RHS: substS (own col (u .: sigma), other cols ids) e
    let rhsArgs ← (Array.range a).mapM fun j =>
      if j == own then `($uI .: $sig)
      else pure (N.idsN j : Term)
    let rhsApp ← substAppT rhsArgs
    cmds := cmds.push (← `(command|
      theorem $selfN { $d* : Nat } $sigB $eB $uB :
          $(N.subst0N si) ($substApp $eI) $uI = $rhsApp $eI := by
        unfold $(N.subst0N si)
        rw [$(N.lemSubstSubst si):term]
        congr 1
        funext x
        cases x with
        | none => rfl
        | some y =>
          simp only [$(N.upN si):ident, scons, shift]
          rw [$(N.lemSubstRen si):term]
          exact $(N.lemSubstId si) ($sig y)))

  -- ========================================================================
  -- variable-computation lemmas: subst<S>_var, ren<S>_var  (both rfl).
  -- Only for sorts that HAVE an own variable constructor (var-less sorts skip).
  -- ========================================================================
  if N.varCtor[si]!.isSome then do
    let xI := mkIdent `x
    -- subst<S>_var: subst<S> sig0 … (var x) = sig_own x
    let sigBs ← (Array.range a).mapM fun j => do
      let vt ← vTy j d
      expBinder (sgD[j]!) (← `(Idx $(tm! d j) → $vt))
    let scB ← natBinder d
    let xBnd ← expBinder xI (← `(Idx $(tm! d own)))
    let substMaps := (Array.range a).map (sgD[·]! : Nat → Term)
    let substApp ← substAppT substMaps
    cmds := cmds.push (← `(command|
      theorem $(N.lemSubstVar si) $scB $sigBs* $xBnd :
          $substApp ($(N.varCtorI si) $xI) = $(tm! sgD own) $xI := rfl))
    -- ren<S>_var: ren<S> xi0 … (var x) = var (xi_own x)
    let xiBs ← (Array.range a).mapM fun j => do
      expBinder (xiD[j]!) (← `(Idx $(tm! d j) → Idx $(tm! e j)))
    let scB2 ← natBinder (d ++ e)
    let xBnd2 ← expBinder xI (← `(Idx $(tm! d own)))
    let renMaps := (Array.range a).map (xiD[·]! : Nat → Term)
    let renApp ← renAppT renMaps
    cmds := cmds.push (← `(command|
      theorem $(N.lemRenVar si) $scB2 $xiBs* $xBnd2 :
          $renApp ($(N.varCtorI si) $xI) = $(N.varCtorI si) ($(tm! xiD own) $xI) := rfl))

  let _ := (valTyOf, termTy, e, f, xiD, zeD, sgD, tauD, natB, own, crossCols, appHd,
            pSc, qSc, rSc, kI, xiH, sgH, renSubstDefs, foreignSorts)
  return cmds

/--
Generate the σ-lemma chain for the whole family.

Statements are synthesised generically from each sort's column structure;
proofs are templated on `Autosubst2/Examples/SysF.lean`.  Per constructor:
* the variable ctor → `rfl`;
* a congruence ctor (recursive/foreign args, no binder) → `simp only [defs]`
  then `rw` the inductive hypotheses;
* a binder ctor → additionally a `have hX : <lifted map> = <up …>` per lifted
  map followed by a `rw`.
-/
def genMultiLemmas (N : MNames) (ctorArr : Array (Array MCtor)) :
    CommandElabM (Array (TSyntax `command)) :=
  liftTermElabM do
  let mut cmds : Array (TSyntax `command) := #[]
  let mut lemCmds : Array (TSyntax `command) := #[]
  for si in [0:N.size] do
    let cmdsSort ← genSortLemmas N ctorArr si
    lemCmds := lemCmds ++ cmdsSort
  -- In shared (mutual-cycle) mode the family's σ-lemmas are mutually recursive
  -- across sorts (e.g. `substTm_substTm` rewrites with `substAssn_substAssn`), so
  -- they must all share one `mutual` block to be in scope for each other.
  if N.shared then
    cmds := #[← `(command| mutual $lemCmds:command* end)]
  else
    cmds := lemCmds
  -- Tag the generated multi-sort chain so a future `asimpl` finds it.
  -- Oriented as the single-sort tagging: composition / identity / up helpers
  -- / var-computation lemmas.
  let mut tagNames : Array Ident := #[]
  for si in [0:N.size] do
    let s := N.sorts[si]!
    let a := s.arity
    let own := a - 1
    let crossCols := (Array.range a).filter (· != own)
    let sub := N.substIdx si
    let genOwnUp := !N.shared || si == sub
    tagNames := tagNames ++ #[N.lemRenRen si, N.lemSubstRen si, N.lemRenSubst si,
      N.lemSubstSubst si, N.lemSubstId si]
    if genOwnUp then
      tagNames := tagNames ++ #[N.lemUpIds si, N.lemUpIdsEq si, N.upN si]
    if N.varCtor[si]!.isSome then
      tagNames := tagNames ++ #[N.subst0N si, N.lemSubstVar si, N.lemRenVar si]
    for b in crossCols do
      tagNames := tagNames ++ #[N.upCrossN si b, N.lemCrossIds si b, N.lemCrossIdsEq si b]
    if (if N.shared then si == sub else N.isLast si) then
      tagNames := tagNames.push (mkIdent `subst0_subst_up)
  cmds := cmds.push (← `(command| attribute [autosubst] $tagNames*))
  pure cmds

/-! ## Unscoped backend (single-sort)

`derive_autosubst% (unscoped) T` takes the WELL-SCOPED indexed inductive
`T : Nat → Type` (the single source of truth for binder depths, via `analyse`)
and emits an UNSCOPED de Bruijn theory in the style of the hand-written
`Heifer/LogRel/Lambda/Subst.lean`.

We pick **option (A)**: generate a fresh unscoped inductive `T.U : Type` whose
constructors mirror `T`'s with the `Nat` scope index erased — the variable
constructor's `Idx n` argument becomes a `Nat`, recursive `T (n+k)` arguments
become `T.U`.  Everything (ops + σ-chain) lives in the `T.U` namespace.  Option
(A) is preferred because generating the inductive via `elabCommand` is tractable
and keeps the macro a single source of truth (the user need not hand-write a
parallel unscoped type, as option (B) would require).

The runtime lives in `Autosubst2.Unscoped` (`uscons (.:)`, `shift`, `upren`,
`var_zero`, `funcomp`).  Generated ops/lemmas (over `Nat → T.U` maps):
`ren`/`up`/`subst`/`ids`/`subst0` and
`upren_comp`(reused)/`ren_ren`/`up_upren`/`subst_ren`/`up_rename`/`ren_subst`/
`up_subst`/`subst_comp`/`up_ids`/`subst_id`/`subst0_subst_up`/`subst_shift`
(the shift/cons cancellation `subst (u ∙ σ) (t⟨↑⟩) = subst σ t`) and its
`reduce`-shaped corollary `subst_shift_red`, matching `Subst.lean`'s statements
adapted to the unscoped runtime names. -/

open Autosubst2.Unscoped in
/-- Generate the unscoped inductive, operations, and σ-lemma chain. -/
def genUnscoped (tyName : Name) (ctors : Array CtorInfo) :
    CommandElabM (Array (TSyntax `command)) := do
  -- Generated names must be RELATIVE to the current namespace (elaboration runs
  -- inside it and re-prefixes), so strip the current-namespace prefix from the
  -- fully-qualified `tyName`.
  let curNs ← getCurrNamespace
  let relTy := tyName.replacePrefix curNs Name.anonymous
  let uName := relTy ++ `U
  let uId := mkIdent uName
  -- runtime primitives (qualified so they resolve regardless of opens).
  let uprenI  := mkIdent ``Autosubst2.Unscoped.upren
  let uprenCompI := mkIdent ``Autosubst2.Unscoped.upren_comp
  -- op + lemma names, all in the `T.U` namespace (non-hygienic, cross-referenced).
  let renI    := mkIdent (uName ++ `ren)
  let upI     := mkIdent (uName ++ `up)
  let substI  := mkIdent (uName ++ `subst)
  let idsI    := mkIdent (uName ++ `ids)
  let consI   := mkIdent (uName ++ `cons)
  let subst0I := mkIdent (uName ++ `subst0)
  let varCtorI := mkIdent (uName ++ varCtorShort ctors)
  let renRenN := mkIdent (uName ++ `ren_ren)
  let upUprenN := mkIdent (uName ++ `up_upren)
  let substRenN := mkIdent (uName ++ `subst_ren)
  let upRenameN := mkIdent (uName ++ `up_rename)
  let renSubstN := mkIdent (uName ++ `ren_subst)
  let upSubstN := mkIdent (uName ++ `up_subst)
  let substCompN := mkIdent (uName ++ `subst_comp)
  let upIdsN := mkIdent (uName ++ `up_ids)
  let substIdN := mkIdent (uName ++ `subst_id)
  let subst0SubstUpN := mkIdent (uName ++ `subst0_subst_up)
  let substShiftN := mkIdent (uName ++ `subst_shift)
  let substShiftRedN := mkIdent (uName ++ `subst_shift_red)
  liftTermElabM do
    -- ===== inductive T.U =====
    let ctorDecls ← ctors.mapM fun c => do
      let short := mkIdent (Name.mkSimple c.name.getString!)
      let mut tys : Array Term := #[]
      for kind in c.args do
        match kind with
        | .var => tys := tys.push (← `(Nat))
        | .recBinders _ => tys := tys.push uId
        | .other ty => tys := tys.push ty
      let mut ty : Term := uId
      for t in tys.reverse do ty ← `($t → $ty)
      `(Lean.Parser.Command.ctor| | $short:ident : $ty)
    let indDef ← `(command|
      inductive $uId : Type where
        $ctorDecls:ctor*)

    let sigma := mkIdent `sigma
    let xi := mkIdent `xi
    -- ===== ren =====
    let renAlts ← ctors.mapM fun c => do
      let short := mkIdent (Name.mkSimple c.name.getString!)
      let pats := argIdents c.args.size
      let dotPat ← `(.$short:ident $pats*)
      if c.isVar then
        let x := pats[0]!
        `(matchAltExpr| | $dotPat => .$short:ident ($xi $x))
      else
        let mut rhs : Array Term := #[]
        for p in pats, kind in c.args do
          match kind with
          | .recBinders k =>
            let mut lifted : Term := xi
            for _ in [0:k] do lifted ← `($uprenI $lifted)
            rhs := rhs.push (← `($renI $lifted $p))
          | _ => rhs := rhs.push p
        `(matchAltExpr| | $dotPat => .$short:ident $rhs*)
    let renDef ← `(command|
      def $renI ($xi : Nat → Nat) : $uId → $uId
        $renAlts:matchAlt*)
    -- ===== up =====
    let upDef ← `(command|
      def $upI ($sigma : Nat → $uId) : Nat → $uId
        | 0     => $varCtorI 0
        | n + 1 => $renI Nat.succ ($sigma n))
    -- ===== subst =====
    let substAlts ← ctors.mapM fun c => do
      let short := mkIdent (Name.mkSimple c.name.getString!)
      let pats := argIdents c.args.size
      let dotPat ← `(.$short:ident $pats*)
      if c.isVar then
        let x := pats[0]!
        `(matchAltExpr| | $dotPat => $sigma $x)
      else
        let mut rhs : Array Term := #[]
        for p in pats, kind in c.args do
          match kind with
          | .recBinders k =>
            let mut lifted : Term := sigma
            for _ in [0:k] do lifted ← `($upI $lifted)
            rhs := rhs.push (← `($substI $lifted $p))
          | _ => rhs := rhs.push p
        `(matchAltExpr| | $dotPat => .$short:ident $rhs*)
    let substDef ← `(command|
      def $substI ($sigma : Nat → $uId) : $uId → $uId
        $substAlts:matchAlt*)
    -- ===== cons / ids / subst0 =====
    let consDef ← `(command|
      def $consI (t : $uId) ($sigma : Nat → $uId) : Nat → $uId
        | 0     => t
        | n + 1 => $sigma n)
    let idsDef ← `(command|
      def $idsI : Nat → $uId := $varCtorI)
    let subst0Def ← `(command|
      def $subst0I (e u : $uId) : $uId := $substI ($consI u $idsI) e)

    -- ===================== σ-chain =====================
    -- The proofs mirror `Subst.lean` exactly, adapted to the generic ctor set
    -- via `mkUIndAlts`.  Helper to build induction alts for `∀ t, LHS = RHS`.
    -- `upren^j`/`up^j` iterated lifts of a base map term.
    let uprenOf (j : Nat) (t : Term) : TermElabM Term := do
      let mut r := t
      for _ in [0:j] do r ← `($uprenI $r)
      pure r
    let upOf (j : Nat) (t : Term) : TermElabM Term := do
      let mut r := t
      for _ in [0:j] do r ← `($upI $r)
      pure r
    let mkUIndAlts (lemmaId : Ident) (defSimp : Array Ident)
        (binderTac : Array Nat → TermElabM (TSyntax `tactic)) :
        TermElabM (Array (TSyntax ``Parser.Term.matchAlt)) :=
      ctors.mapM fun c => do
        let short := mkIdent (Name.mkSimple c.name.getString!)
        let pats := argIdents c.args.size
        let dotPat ← `(.$short:ident $pats*)
        if c.isVar then
          `(matchAltExpr| | $dotPat => rfl)
        else
          let recCount := c.args.foldl (fun acc k =>
            match k with | .recBinders _ => acc+1 | _ => acc) 0
          let rws ← (Array.range recCount).mapM
            (fun _ => `(Lean.Parser.Tactic.rwRule| $lemmaId:ident))
          if isBinderCtor c then
            let upTac ← binderTac (binderDepths c)
            `(matchAltExpr| | $dotPat => by
                simp only [$[$defSimp:ident],*]
                rw [$[$rws],*]
                $upTac:tactic)
          else if rws.isEmpty then
            `(matchAltExpr| | $dotPat => by simp only [$[$defSimp:ident],*])
          else
            `(matchAltExpr| | $dotPat => by simp only [$[$defSimp:ident],*]; rw [$[$rws],*])

    -- ren_ren
    let renRenAlts ← mkUIndAlts renRenN #[renI] fun depths =>
      mkUpChainTac depths
        (fun j => do uprenOf j (← `(zeta)))
        (fun j => do uprenOf j (← `(xi)))
        (fun j => do uprenOf j (← `(fun m => zeta (xi m))))
        (fun j => do
          let xiJ ← uprenOf j (← `(xi))
          let zetaJ ← uprenOf j (← `(zeta))
          `($uprenCompI $xiJ $zetaJ x))
    let renRen ← `(command|
      theorem $renRenN (xi zeta : Nat → Nat) :
          ∀ t : $uId, $renI zeta ($renI xi t) = $renI (fun m => zeta (xi m)) t
        $renRenAlts:matchAlt*)

    -- up_upren : up σ (upren ξ n) = up (fun m => σ (ξ m)) n
    let upUpren ← `(command|
      theorem $upUprenN (sigma : Nat → $uId) (xi : Nat → Nat) (n : Nat) :
          $upI sigma ($uprenI xi n) = $upI (fun m => sigma (xi m)) n := by
        cases n <;> simp [$upI:ident, $uprenI:ident])

    -- subst_ren
    let substRenAlts ← mkUIndAlts substRenN #[renI, substI] fun depths =>
      mkUpChainTac depths
        (fun j => do upOf j (← `(sigma)))
        (fun j => do uprenOf j (← `(xi)))
        (fun j => do upOf j (← `(fun m => sigma (xi m))))
        (fun j => do
          let sJ ← upOf j (← `(sigma))
          let xiJ ← uprenOf j (← `(xi))
          `($upUprenN $sJ $xiJ x))
    let substRen ← `(command|
      theorem $substRenN (sigma : Nat → $uId) (xi : Nat → Nat) :
          ∀ t : $uId, $substI sigma ($renI xi t) = $substI (fun m => sigma (xi m)) t
        $substRenAlts:matchAlt*)

    -- up_rename : up (fun m => ren ξ (σ m)) n = ren (upren ξ) (up σ n)
    let upRename ← `(command|
      theorem $upRenameN (xi : Nat → Nat) (sigma : Nat → $uId) (n : Nat) :
          $upI (fun m => $renI xi (sigma m)) n = $renI ($uprenI xi) ($upI sigma n) := by
        cases n with
        | zero => rfl
        | succ k =>
          simp only [$upI:ident]
          rw [$renRenN:term, $renRenN:term]
          have h : (fun m => Nat.succ (xi m)) = (fun m => $uprenI xi (Nat.succ m)) := by
            funext m; rfl
          rw [h])

    -- ren_subst
    let renSubstAlts ← mkUIndAlts renSubstN #[substI, renI] fun depths =>
      mkUpChainTac depths
        (fun j => do `($renI $(← uprenOf j (← `(xi)))))
        (fun j => do upOf j (← `(sigma)))
        (fun j => do upOf j (← `(fun m => $renI xi (sigma m))))
        (fun j => do
          let xiJ ← uprenOf j (← `(xi))
          let sJ ← upOf j (← `(sigma))
          `(($upRenameN $xiJ $sJ x).symm))
    let renSubst ← `(command|
      theorem $renSubstN (xi : Nat → Nat) (sigma : Nat → $uId) :
          ∀ t : $uId, $renI xi ($substI sigma t) = $substI (fun m => $renI xi (sigma m)) t
        $renSubstAlts:matchAlt*)

    -- up_subst : up (fun m => subst τ (σ m)) n = subst (up τ) (up σ n)
    let upSubst ← `(command|
      theorem $upSubstN (sigma tau : Nat → $uId) (n : Nat) :
          $upI (fun m => $substI tau (sigma m)) n = $substI ($upI tau) ($upI sigma n) := by
        cases n with
        | zero => rfl
        | succ k =>
          simp only [$upI:ident]
          rw [$renSubstN:term, $substRenN:term]
          have h : (fun m => $upI tau (Nat.succ m)) = (fun m => $renI Nat.succ (tau m)) := by
            funext m; rfl
          rw [h])

    -- subst_comp
    let substCompAlts ← mkUIndAlts substCompN #[substI] fun depths =>
      mkUpChainTac depths
        (fun j => do `($substI $(← upOf j (← `(tau)))))
        (fun j => do upOf j (← `(sigma)))
        (fun j => do upOf j (← `(fun m => $substI tau (sigma m))))
        (fun j => do
          let sJ ← upOf j (← `(sigma))
          let tauJ ← upOf j (← `(tau))
          `(($upSubstN $sJ $tauJ x).symm))
    let substComp ← `(command|
      theorem $substCompN (sigma tau : Nat → $uId) :
          ∀ t : $uId, $substI tau ($substI sigma t) = $substI (fun m => $substI tau (sigma m)) t
        $substCompAlts:matchAlt*)

    -- up_ids
    let upIds ← `(command|
      theorem $upIdsN (n : Nat) : $upI $idsI n = $idsI n := by
        cases n <;> rfl)

    -- Function-level identity: collapses `up (… (up ids))` at ANY binder depth.
    let upIdsEqN := mkIdent (uName ++ `up_ids_eq)
    let upIdsEq ← `(command|
      theorem $upIdsEqN : $upI $idsI = $idsI := by
        funext n; exact $upIdsN n)

    -- subst_id (bespoke: binder legs collapse the lifts BEFORE the IH)
    let substIdAlts ← ctors.mapM fun c => do
      let short := mkIdent (Name.mkSimple c.name.getString!)
      let pats := argIdents c.args.size
      let dotPat ← `(.$short:ident $pats*)
      if c.isVar then
        `(matchAltExpr| | $dotPat => rfl)
      else
        let recCount := c.args.foldl (fun acc k =>
          match k with | .recBinders _ => acc+1 | _ => acc) 0
        let rws ← (Array.range recCount).mapM
          (fun _ => `(Lean.Parser.Tactic.rwRule| $substIdN:ident))
        if rws.isEmpty then
          `(matchAltExpr| | $dotPat => by simp only [$substI:ident])
        else
          `(matchAltExpr| | $dotPat => by
              simp only [$substI:ident, $upIdsEqN:ident]; rw [$[$rws],*])
    let substId ← `(command|
      theorem $substIdN : ∀ (t : $uId), $substI $idsI t = t
        $substIdAlts:matchAlt*)

    -- subst0_subst_up
    let subst0SubstUp ← `(command|
      theorem $subst0SubstUpN (sigma : Nat → $uId) (e u : $uId) :
          $subst0I ($substI ($upI sigma) e) u = $substI ($consI u sigma) e := by
        unfold $subst0I
        rw [$substCompN:term]
        congr 1
        funext n
        cases n with
        | zero => rfl
        | succ k =>
          simp only [$upI:ident, $consI:ident]
          rw [$substRenN:term]
          have h : (fun m => $consI u $idsI (Nat.succ m)) = $idsI := by
            funext m; rfl
          rw [h, $substIdN:term])

    -- subst_shift: the shift/cons cancellation `subst (u ∙ σ) (t⟨↑⟩) = subst σ t`
    let substShift ← `(command|
      theorem $substShiftN (u : $uId) (sigma : Nat → $uId) :
          ∀ t : $uId, $substI ($consI u sigma) ($renI Nat.succ t) = $substI sigma t := by
        intro t
        rw [$substRenN:term]
        have h : (fun m => $consI u sigma (Nat.succ m)) = sigma := by funext m; rfl
        rw [h])
    -- subst_shift_red: the `subst0` instance of `subst_shift`, stated in the shape
    -- `conv => reduce` leaves behind (the `cons _ ids` map computed to its
    -- `Nat.rec` normal form), so that tactics normalising substitutions by
    -- evaluation can use it as a `simp` lemma.
    let substShiftRed ← `(command|
      theorem $substShiftRedN (u : $uId) :
          ∀ t : $uId, $substI (fun x => Nat.rec u (fun k _ => $varCtorI k) x)
            ($renI Nat.succ t) = t := by
        intro t
        have h : (fun x => Nat.rec u (fun k _ => $varCtorI k) x) = $consI u $idsI := by
          funext x; cases x <;> rfl
        rw [h, $substShiftN:term, $substIdN:term])
    pure #[indDef, renDef, upDef, substDef, consDef, idsDef, subst0Def,
           renRen, upUpren, substRen, upRename, renSubst, upSubst, substComp,
           upIds, upIdsEq, substId, subst0SubstUp, substShift, substShiftRed]

/-! ## Unscoped backend (multi-sort, shared scope)

`derive_autosubst% (unscoped) S0 S1 …` for a MUTUAL family with ONE shared
term-variable scope: every sort has scope arity 1, only the FIRST sort has a
variable constructor, and the family substitutes into `S0` (the shared
substitute sort) — the unscoped analogue of the scoped shared/mutual-cycle mode
(`derive_autosubst% Tm Assn`).

Generates the mutual unscoped inductives `S0.U, S1.U, …` and, per sort,
`Si.U.ren`/`Si.U.subst` (mutual), sharing `S0.U.up`/`cons`/`ids`/`subst0`, plus
the mutual σ-chain (`ren_ren`/`subst_ren`/`ren_subst`/`subst_comp`/`subst_id`
per sort, `subst_shift`/`subst_shift_red` per sort, up-helpers and
`subst0_subst_up` on `S0.U`).  Payload (`.other`) args
are carried verbatim with their source types; foreign subterms may sit under
one binder (offset 1, e.g. `Val.clos : Expr (k+1) → Val k`). -/

open Autosubst2.Unscoped in
/-- Generate the unscoped mutual inductive family, operations, and σ-chain. -/
def genUnscopedMulti (sortNames : Array Name) (ctorArr : Array (Array MCtor)) :
    CommandElabM (Array (TSyntax `command)) := do
  let curNs ← getCurrNamespace
  let n := sortNames.size
  let uNames := sortNames.map fun nm => (nm.replacePrefix curNs Name.anonymous) ++ `U
  let uId (i : Nat) : Ident := mkIdent uNames[i]!
  let idxOf (nm : Name) : Nat := (sortNames.findIdx? (· == nm)).getD 0
  -- runtime primitives.
  let uprenI := mkIdent ``Autosubst2.Unscoped.upren
  let uprenCompI := mkIdent ``Autosubst2.Unscoped.upren_comp
  -- per-sort op/lemma names; shared `up`/`cons`/`ids`/`subst0` live on sort 0.
  let renI (i : Nat) : Ident := mkIdent (uNames[i]! ++ `ren)
  let substI (i : Nat) : Ident := mkIdent (uNames[i]! ++ `subst)
  let upI : Ident := mkIdent (uNames[0]! ++ `up)
  let consI : Ident := mkIdent (uNames[0]! ++ `cons)
  let idsI : Ident := mkIdent (uNames[0]! ++ `ids)
  let subst0I : Ident := mkIdent (uNames[0]! ++ `subst0)
  let varCtorI : Ident := mkIdent <| uNames[0]! ++
    (((ctorArr[0]!.find? MCtor.isVar).map fun c => Name.mkSimple c.name.getString!).getD `var)
  let renRenN (i : Nat) : Ident := mkIdent (uNames[i]! ++ `ren_ren)
  let substRenN (i : Nat) : Ident := mkIdent (uNames[i]! ++ `subst_ren)
  let renSubstN (i : Nat) : Ident := mkIdent (uNames[i]! ++ `ren_subst)
  let substCompN (i : Nat) : Ident := mkIdent (uNames[i]! ++ `subst_comp)
  let substIdN (i : Nat) : Ident := mkIdent (uNames[i]! ++ `subst_id)
  let upUprenN : Ident := mkIdent (uNames[0]! ++ `up_upren)
  let upRenameN : Ident := mkIdent (uNames[0]! ++ `up_rename)
  let upSubstN : Ident := mkIdent (uNames[0]! ++ `up_subst)
  let upIdsN : Ident := mkIdent (uNames[0]! ++ `up_ids)
  let subst0SubstUpN : Ident := mkIdent (uNames[0]! ++ `subst0_subst_up)
  let substShiftN (i : Nat) : Ident := mkIdent (uNames[i]! ++ `subst_shift)
  let substShiftRedN (i : Nat) : Ident := mkIdent (uNames[i]! ++ `subst_shift_red)
  -- binder depth of an argument (shared scope ⇒ single column).
  let depthOf : MArg → Nat := fun
    | .recur offs => offs.getD 0 0
    | .foreign _ offs => offs.getD 0 0
    | _ => 0
  -- the sort index an argument recurses into (`none` for var/payload args).
  let recSortOf (si : Nat) : MArg → Option Nat := fun
    | .recur _ => some si
    | .foreign fnm _ => some (idxOf fnm)
    | _ => none
  let hasBinder (c : MCtor) : Bool := c.args.any fun a => depthOf a > 0
  for mcs in ctorArr do
    for c in mcs do
      for a in c.args do
        if depthOf a > 2 then
          throwError "derive_autosubst% (unscoped): argument of {c.name} sits under {depthOf a} binders; only depth ≤ 2 is supported"
  liftTermElabM do
    let mut cmds : Array (TSyntax `command) := #[]
    -- ===== mutual inductive family =====
    let mut indDefs : Array (TSyntax `command) := #[]
    for si in [0:n] do
      let ctorDecls ← ctorArr[si]!.mapM fun c => do
        let short := mkIdent (Name.mkSimple c.name.getString!)
        let mut tys : Array Term := #[]
        for a in c.args do
          match a with
          | .var _ => tys := tys.push (← `(Nat))
          | .recur _ => tys := tys.push (uId si)
          | .foreign fnm _ => tys := tys.push (uId (idxOf fnm))
          | .other ty => tys := tys.push ty
        let mut ty : Term := uId si
        for t in tys.reverse do ty ← `($t → $ty)
        `(Lean.Parser.Command.ctor| | $short:ident : $ty)
      indDefs := indDefs.push (← `(command|
        inductive $(uId si) : Type where
          $ctorDecls:ctor*))
    cmds := cmds.push (← `(command| mutual $indDefs:command* end))

    let sigma := mkIdent `sigma
    let xi := mkIdent `xi
    -- ===== ren (mutual) =====
    let mut renDefs : Array (TSyntax `command) := #[]
    for si in [0:n] do
      let renAlts ← ctorArr[si]!.mapM fun c => do
        let short := mkIdent (Name.mkSimple c.name.getString!)
        let pats := argIdents c.args.size
        let dotPat ← `(.$short:ident $pats*)
        if c.isVar then
          let x := pats[0]!
          `(matchAltExpr| | $dotPat => .$short:ident ($xi $x))
        else
          let mut rhs : Array Term := #[]
          for p in pats, a in c.args do
            match recSortOf si a with
            | some ri =>
              let mut lifted : Term := xi
              for _ in [0:depthOf a] do lifted ← `($uprenI $lifted)
              rhs := rhs.push (← `($(renI ri) $lifted $p))
            | none => rhs := rhs.push p
          `(matchAltExpr| | $dotPat => .$short:ident $rhs*)
      renDefs := renDefs.push (← `(command|
        def $(renI si) ($xi : Nat → Nat) : $(uId si) → $(uId si)
          $renAlts:matchAlt*))
    cmds := cmds.push (← `(command| mutual $renDefs:command* end))
    -- ===== up (shared, on the substitute sort) =====
    cmds := cmds.push (← `(command|
      def $upI ($sigma : Nat → $(uId 0)) : Nat → $(uId 0)
        | 0     => $varCtorI 0
        | n + 1 => $(renI 0) Nat.succ ($sigma n)))
    -- ===== subst (mutual) =====
    let mut substDefs : Array (TSyntax `command) := #[]
    for si in [0:n] do
      let substAlts ← ctorArr[si]!.mapM fun c => do
        let short := mkIdent (Name.mkSimple c.name.getString!)
        let pats := argIdents c.args.size
        let dotPat ← `(.$short:ident $pats*)
        if c.isVar then
          let x := pats[0]!
          `(matchAltExpr| | $dotPat => $sigma $x)
        else
          let mut rhs : Array Term := #[]
          for p in pats, a in c.args do
            match recSortOf si a with
            | some ri =>
              let mut lifted : Term := sigma
              for _ in [0:depthOf a] do lifted ← `($upI $lifted)
              rhs := rhs.push (← `($(substI ri) $lifted $p))
            | none => rhs := rhs.push p
          `(matchAltExpr| | $dotPat => .$short:ident $rhs*)
      substDefs := substDefs.push (← `(command|
        def $(substI si) ($sigma : Nat → $(uId 0)) : $(uId si) → $(uId si)
          $substAlts:matchAlt*))
    cmds := cmds.push (← `(command| mutual $substDefs:command* end))
    -- ===== cons / ids / subst0 (substitute sort) =====
    cmds := cmds.push (← `(command|
      def $consI (t : $(uId 0)) ($sigma : Nat → $(uId 0)) : Nat → $(uId 0)
        | 0     => t
        | n + 1 => $sigma n))
    cmds := cmds.push (← `(command| def $idsI : Nat → $(uId 0) := $varCtorI))
    cmds := cmds.push (← `(command|
      def $subst0I (e u : $(uId 0)) : $(uId 0) := $(substI 0) ($consI u $idsI) e))

    -- ===================== σ-chain =====================
    -- generic leg builder for `∀ t : Si.U, LHS = RHS` mutual lemmas.
    -- `lemOf ri` gives the lemma to rewrite for an argument recursing into sort
    -- `ri` (the mutual IH).  Binder legs run `binderTac` AFTER the rws (or, for
    -- `preTac`-style lemmas like `subst_id`, a `have` BEFORE them).
    let allRen : Array Ident := (Array.range n).map renI
    let allSubst : Array Ident := (Array.range n).map substI
    -- distinct positive binder depths of a ctor's recursive args, ascending
    let binderDepthsM (c : MCtor) : Array Nat :=
      ((c.args.filterMap fun a =>
          let d := depthOf a; if d > 0 then some d else none).toList.eraseDups.toArray).qsort (· < ·)
    -- `upren^j`/`up^j` iterated lifts of a base map term.
    let uprenOf (j : Nat) (t : Term) : TermElabM Term := do
      let mut r := t
      for _ in [0:j] do r ← `($uprenI $r)
      pure r
    let upOf (j : Nat) (t : Term) : TermElabM Term := do
      let mut r := t
      for _ in [0:j] do r ← `($upI $r)
      pure r
    let mkMAlts (si : Nat) (lemOf : Nat → Ident) (defSimp : Array Ident)
        (binderTac : Option (Array Nat → TermElabM (TSyntax `tactic)))
        (preHave : Option (TSyntax `tactic)) :
        TermElabM (Array (TSyntax ``Parser.Term.matchAlt)) :=
      ctorArr[si]!.mapM fun c => do
        let short := mkIdent (Name.mkSimple c.name.getString!)
        let pats := argIdents c.args.size
        let dotPat ← `(.$short:ident $pats*)
        if c.isVar then
          `(matchAltExpr| | $dotPat => rfl)
        else
          let mut rws : Array (TSyntax ``Lean.Parser.Tactic.rwRule) := #[]
          for a in c.args do
            match recSortOf si a with
            | some ri => rws := rws.push (← `(Lean.Parser.Tactic.rwRule| $(lemOf ri):ident))
            | none => pure ()
          if hasBinder c then
            match preHave with
            | some pre =>
              `(matchAltExpr| | $dotPat => by
                  simp only [$[$defSimp:ident],*]
                  $pre:tactic
                  rw [$[$rws],*])
            | none =>
              let tac ← binderTac.get! (binderDepthsM c)
              `(matchAltExpr| | $dotPat => by
                  simp only [$[$defSimp:ident],*]
                  rw [$[$rws],*]
                  $tac:tactic)
          else if rws.isEmpty then
            `(matchAltExpr| | $dotPat => by simp only [$[$defSimp:ident],*])
          else
            `(matchAltExpr| | $dotPat => by simp only [$[$defSimp:ident],*]; rw [$[$rws],*])
    -- ren_ren (mutual over sorts)
    let renRenTac : Array Nat → TermElabM (TSyntax `tactic) := fun depths =>
      mkUpChainTac depths
        (fun j => do uprenOf j (← `(zeta)))
        (fun j => do uprenOf j (← `(xi)))
        (fun j => do uprenOf j (← `(fun m => zeta (xi m))))
        (fun j => do
          let xiJ ← uprenOf j (← `(xi))
          let zetaJ ← uprenOf j (← `(zeta))
          `($uprenCompI $xiJ $zetaJ x))
    let mut renRens : Array (TSyntax `command) := #[]
    for si in [0:n] do
      let alts ← mkMAlts si renRenN allRen (some renRenTac) none
      renRens := renRens.push (← `(command|
        theorem $(renRenN si) (xi zeta : Nat → Nat) :
            ∀ t : $(uId si), $(renI si) zeta ($(renI si) xi t) = $(renI si) (fun m => zeta (xi m)) t
          $alts:matchAlt*))
    cmds := cmds.push (← `(command| mutual $renRens:command* end))
    -- up_upren
    cmds := cmds.push (← `(command|
      theorem $upUprenN (sigma : Nat → $(uId 0)) (xi : Nat → Nat) (n : Nat) :
          $upI sigma ($uprenI xi n) = $upI (fun m => sigma (xi m)) n := by
        cases n <;> simp [$upI:ident, $uprenI:ident]))
    -- subst_ren (mutual)
    let substRenTac : Array Nat → TermElabM (TSyntax `tactic) := fun depths =>
      mkUpChainTac depths
        (fun j => do upOf j (← `(sigma)))
        (fun j => do uprenOf j (← `(xi)))
        (fun j => do upOf j (← `(fun m => sigma (xi m))))
        (fun j => do
          let sJ ← upOf j (← `(sigma))
          let xiJ ← uprenOf j (← `(xi))
          `($upUprenN $sJ $xiJ x))
    let mut substRens : Array (TSyntax `command) := #[]
    for si in [0:n] do
      let alts ← mkMAlts si substRenN (allRen ++ allSubst) (some substRenTac) none
      substRens := substRens.push (← `(command|
        theorem $(substRenN si) (sigma : Nat → $(uId 0)) (xi : Nat → Nat) :
            ∀ t : $(uId si), $(substI si) sigma ($(renI si) xi t) = $(substI si) (fun m => sigma (xi m)) t
          $alts:matchAlt*))
    cmds := cmds.push (← `(command| mutual $substRens:command* end))
    -- up_rename
    cmds := cmds.push (← `(command|
      theorem $upRenameN (xi : Nat → Nat) (sigma : Nat → $(uId 0)) (n : Nat) :
          $upI (fun m => $(renI 0) xi (sigma m)) n = $(renI 0) ($uprenI xi) ($upI sigma n) := by
        cases n with
        | zero => rfl
        | succ k =>
          simp only [$upI:ident]
          rw [$(renRenN 0):term, $(renRenN 0):term]
          have h : (fun m => Nat.succ (xi m)) = (fun m => $uprenI xi (Nat.succ m)) := by
            funext m; rfl
          rw [h]))
    -- ren_subst (mutual)
    let renSubstTac : Array Nat → TermElabM (TSyntax `tactic) := fun depths =>
      mkUpChainTac depths
        (fun j => do `($(renI 0) $(← uprenOf j (← `(xi)))))
        (fun j => do upOf j (← `(sigma)))
        (fun j => do upOf j (← `(fun m => $(renI 0) xi (sigma m))))
        (fun j => do
          let xiJ ← uprenOf j (← `(xi))
          let sJ ← upOf j (← `(sigma))
          `(($upRenameN $xiJ $sJ x).symm))
    let mut renSubsts : Array (TSyntax `command) := #[]
    for si in [0:n] do
      let alts ← mkMAlts si renSubstN (allRen ++ allSubst) (some renSubstTac) none
      renSubsts := renSubsts.push (← `(command|
        theorem $(renSubstN si) (xi : Nat → Nat) (sigma : Nat → $(uId 0)) :
            ∀ t : $(uId si), $(renI si) xi ($(substI si) sigma t) = $(substI si) (fun m => $(renI 0) xi (sigma m)) t
          $alts:matchAlt*))
    cmds := cmds.push (← `(command| mutual $renSubsts:command* end))
    -- up_subst
    cmds := cmds.push (← `(command|
      theorem $upSubstN (sigma tau : Nat → $(uId 0)) (n : Nat) :
          $upI (fun m => $(substI 0) tau (sigma m)) n = $(substI 0) ($upI tau) ($upI sigma n) := by
        cases n with
        | zero => rfl
        | succ k =>
          simp only [$upI:ident]
          rw [$(renSubstN 0):term, $(substRenN 0):term]
          have h : (fun m => $upI tau (Nat.succ m)) = (fun m => $(renI 0) Nat.succ (tau m)) := by
            funext m; rfl
          rw [h]))
    -- subst_comp (mutual)
    let substCompTac : Array Nat → TermElabM (TSyntax `tactic) := fun depths =>
      mkUpChainTac depths
        (fun j => do `($(substI 0) $(← upOf j (← `(tau)))))
        (fun j => do upOf j (← `(sigma)))
        (fun j => do upOf j (← `(fun m => $(substI 0) tau (sigma m))))
        (fun j => do
          let sJ ← upOf j (← `(sigma))
          let tauJ ← upOf j (← `(tau))
          `(($upSubstN $sJ $tauJ x).symm))
    let mut substComps : Array (TSyntax `command) := #[]
    for si in [0:n] do
      let alts ← mkMAlts si substCompN allSubst (some substCompTac) none
      substComps := substComps.push (← `(command|
        theorem $(substCompN si) (sigma tau : Nat → $(uId 0)) :
            ∀ t : $(uId si), $(substI si) tau ($(substI si) sigma t) = $(substI si) (fun m => $(substI 0) tau (sigma m)) t
          $alts:matchAlt*))
    cmds := cmds.push (← `(command| mutual $substComps:command* end))
    -- up_ids
    cmds := cmds.push (← `(command|
      theorem $upIdsN (n : Nat) : $upI $idsI n = $idsI n := by
        cases n <;> rfl))
    -- subst_id (mutual; binder legs rewrite `up ids = ids` BEFORE the IHs)
    let substIdPre ← `(tactic|
      (have h : $upI $idsI = $idsI := by funext n; exact $upIdsN n
       simp only [h]))
    let mut substIds : Array (TSyntax `command) := #[]
    for si in [0:n] do
      let alts ← mkMAlts si substIdN allSubst none (some substIdPre)
      substIds := substIds.push (← `(command|
        theorem $(substIdN si) : ∀ (t : $(uId si)), $(substI si) $idsI t = t
          $alts:matchAlt*))
    cmds := cmds.push (← `(command| mutual $substIds:command* end))
    -- subst0_subst_up (substitute sort)
    cmds := cmds.push (← `(command|
      theorem $subst0SubstUpN (sigma : Nat → $(uId 0)) (e u : $(uId 0)) :
          $subst0I ($(substI 0) ($upI sigma) e) u = $(substI 0) ($consI u sigma) e := by
        unfold $subst0I
        rw [$(substCompN 0):term]
        congr 1
        funext n
        cases n with
        | zero => rfl
        | succ k =>
          simp only [$upI:ident, $consI:ident]
          rw [$(substRenN 0):term]
          have h : (fun m => $consI u $idsI (Nat.succ m)) = $idsI := by
            funext m; rfl
          rw [h, $(substIdN 0):term]))
    -- subst_shift (per sort): the shift/cons cancellation `subst (u ∙ σ) (t⟨↑⟩) = subst σ t`,
    -- plus `subst_shift_red`, its `subst0` instance stated in the shape a
    -- `conv => reduce` normalisation leaves behind (the `cons _ ids` map computed
    -- to its `Nat.rec` normal form), usable as a `simp` lemma by such tactics.
    for si in [0:n] do
      cmds := cmds.push (← `(command|
        theorem $(substShiftN si) (u : $(uId 0)) (sigma : Nat → $(uId 0)) :
            ∀ t : $(uId si), $(substI si) ($consI u sigma) ($(renI si) Nat.succ t)
              = $(substI si) sigma t := by
          intro t
          rw [$(substRenN si):term]
          have h : (fun m => $consI u sigma (Nat.succ m)) = sigma := by funext m; rfl
          rw [h]))
      cmds := cmds.push (← `(command|
        theorem $(substShiftRedN si) (u : $(uId 0)) :
            ∀ t : $(uId si), $(substI si) (fun x => Nat.rec u (fun k _ => $varCtorI k) x)
              ($(renI si) Nat.succ t) = t := by
          intro t
          have h : (fun x => Nat.rec u (fun k _ => $varCtorI k) x) = $consI u $idsI := by
            funext x; cases x <;> rfl
          rw [h, $(substShiftN si):term, $(substIdN si):term]))
    pure cmds

/-! ## The command -/

/-- `derive_autosubst% T` generates the substitution operations and σ-lemma
chain for the single-sort well-scoped inductive `T : Nat → Type`.  Run it in the
namespace where the operations should live (typically the same as `T`).

`derive_autosubst% S0 S1 …` processes a list of sorts as a mutual family,
emitting the vector-substitution theory (one map per contained variable sort,
cross-sort lifts under binders). -/
syntax (name := deriveAutosubst) "derive_autosubst% " (atomic("(" &"unscoped" ")"))? ident+ : command

@[command_elab deriveAutosubst]
def elabDeriveAutosubst : CommandElab := fun stx => do
  match stx with
  | `(derive_autosubst% (unscoped) $tyIds:ident*) => do
    let names ← tyIds.mapM fun i =>
      liftCoreM <| Lean.realizeGlobalConstNoOverloadCore i.getId
    if names.size = 1 then
      let tyName := names[0]!
      let ctors ← liftTermElabM <| analyse tyName
      for cmd in (← genUnscoped tyName ctors) do
        elabGen cmd
    else do
      -- unscoped MUTUAL family: shared-scope shape only (arity 1 everywhere,
      -- the FIRST sort is the unique variable-bearing sort).
      let (sorts, ctorArr) ← liftTermElabM <| analyseMulti names
      unless sorts.all (·.arity == 1) do
        throwError "derive_autosubst% (unscoped): mutual families are only supported when every sort has scope arity 1 (one shared variable scope)"
      let varBearing := ctorArr.map fun mcs => (mcs.find? MCtor.isVar).isSome
      unless varBearing[0]! do
        throwError "derive_autosubst% (unscoped): the FIRST sort must be the variable-bearing sort"
      for i in [1:varBearing.size] do
        if varBearing[i]! then
          throwError "derive_autosubst% (unscoped): only the first sort may have a variable constructor (single shared substitute sort)"
      for cmd in (← genUnscopedMulti names ctorArr) do
        elabGen cmd
  | `(derive_autosubst% $tyIds:ident*) => do
    let names ← tyIds.mapM fun i =>
      liftCoreM <| Lean.realizeGlobalConstNoOverloadCore i.getId
    if h : names.size = 1 then
      -- single-sort path: unchanged behaviour.
      let tyName := names[0]
      let ctors ← liftTermElabM <| analyse tyName
      for cmd in (← genOps tyName ctors) do
        elabGen cmd
      for cmd in (← genLemmas tyName ctors) do
        elabGen cmd
    else do
      let (sorts, ctorArr) ← liftTermElabM <| analyseMulti names
      -- compute var ctor names per sort (`none` for var-less sorts).
      let varCtor : Array (Option Name) := ctorArr.map fun mcs =>
        (mcs.find? MCtor.isVar).map (·.name)
      let varShort : Array (Option Name) :=
        varCtor.map fun n? => n?.map fun n => Name.mkSimple n.getString!
      -- "shared substitute sort" mode: some sort is var-less.  Then the whole
      -- family shares one scope column and substitutes into `sorts[0]`.
      let shared := varCtor.any (·.isNone)
      if shared then do
        unless sorts.all (·.arity == 1) do
          throwError "derive_autosubst%: var-less (shared-scope) families are only supported when every sort has scope arity 1"
        unless varCtor[0]!.isSome do
          throwError "derive_autosubst%: in a shared-scope family the FIRST sort must be the variable-bearing sort"
      let N : MNames := { sorts := sorts, varCtor := varCtor, varShort := varShort, shared := shared }
      for cmd in (← genMultiOps N ctorArr) do
        elabGen cmd
      for cmd in (← genMultiLemmas N ctorArr) do
        elabGen cmd
  | _ => throwUnsupportedSyntax

end Autosubst2.Deriving
